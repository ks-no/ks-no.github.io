{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Fiks: Autorisasjon query service for grupper",
    "description": "KS Fiks: Autorisasjon query service",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ks.no"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://autorisasjon-query-service:8080",
      "description": "Cluster internal service URI"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Grupper",
      "description": "API for oppslag på grupper"
    }
  ],
  "paths": {
    "/autorisasjon-query/api/v1/organisasjoner/{fiksorg}/grupper": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksorg"
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Henter grupper",
        "summary": "Henter alle grupper på fiksorg",
        "operationId": "hentGrupper",
        "responses": {
          "200": {
            "description": "Grupper på fiksorg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Grupper"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      }
    },
    "/autorisasjon-query/api/v1/organisasjoner/{fiksorg}/grupper/{gruppe}": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksorg"
          },
          {
            "$ref": "#/components/parameters/gruppe"
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Henter grupper",
        "summary": "Henter gruppe på fiksorg",
        "operationId": "hentGruppe",
        "responses": {
          "200": {
            "description": "Grupper på fiksorg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gruppe"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          },
          "404": {
            "$ref": "#/components/responses/ikkeFunnet"
          }
        }
      }
    },
    "/autorisasjon-query/api/v1/organisasjoner/{fiksorg}/grupper/{gruppe}/medlemmer": {
      "get": {
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksorg"
          },
          {
            "$ref": "#/components/parameters/gruppe"
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Henter medlemmer i gruppe",
        "summary": "Henter alle medlemmer i gruppe",
        "operationId": "hentMedlemmerIGruppe",
        "responses": {
          "200": {
            "description": "Medlemmer i gruppe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Brukere"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "fiksorg": {
        "name": "fiksorg",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/FiksOrgId"
        }
      },
      "gruppe": {
        "name": "gruppe",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/GruppeId"
        }
      }
    },
    "schemas": {
      "GruppeId": {
        "type": "string",
        "format": "uuid",
        "description": "Gruppe id",
        "example": "eae3db69-92fa-436d-98a0-61b27de52cf7"
      },
      "FiksOrgId": {
        "type": "string",
        "format": "uuid",
        "description": "Fiksorg id",
        "example": "5c6a590a-f34c-4694-a668-c56e161feb2f"
      },
      "PersonId": {
        "type": "string",
        "format": "uuid",
        "description": "Unik bruker id",
        "example": "17d86466-6672-45fe-8414-cc39f693ba7d"
      },
      "EksternRef": {
        "type": "string",
        "format": "uuid",
        "description": "Ekstern referanse",
        "example": "325b9601-97b5-4788-992b-24720da01bd0"
      },
      "Fodselsnummer": {
        "description": "Fødselsnummer",
        "type": "string",
        "pattern": "^[0-9]{11}$",
        "example": "09274734199"
      },
      "Gruppe": {
        "type": "object",
        "properties": {
          "navn": {
            "type": "string",
            "description": "Visningsnavn på gruppe",
            "maxLength": 200,
            "minLength": 2,
            "pattern": "^[A-ZÆØÅa-zæøå0-9ÁáÀàÂâÉéÈèÊêÍíÌìÎîÓóÒòÔôÚúÙùÛûÝýÄäËëÏïÖöÜü,.!?\\-:;/\\\\'()&+*=%§]+[A-ZÆØÅa-zæøå0-9ÁáÀàÂâÉéÈèÊêÍíÌìÎîÓóÒòÔôÚúÙùÛûÝýÄäËëÏïÖöÜü ,.!?\\-:;/\\\\'()&+*=%§]*[A-ZÆØÅa-zæøå0-9ÁáÀàÂâÉéÈèÊêÍíÌìÎîÓóÒòÔôÚúÙùÛûÝýÄäËëÏïÖöÜü,.!?\\-:;/\\\\'()&+*=%§]+$"
          },
          "id": {
            "$ref": "#/components/schemas/GruppeId"
          },
          "kilde": {
            "$ref": "#/components/schemas/GruppeKilde"
          },
          "eksternRef": {
            "$ref": "#/components/schemas/EksternRef"
          }
        },
        "required": [
          "navn",
          "id",
          "kilde"
        ]
      },
      "Grupper": {
        "type": "object",
        "properties": {
          "fiksorg": {
            "$ref": "#/components/schemas/FiksOrgId"
          },
          "grupper": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gruppe"
            }
          }
        },
        "required": [
          "fiksorg",
          "grupper"
        ]
      },
      "GruppeKilde": {
        "type": "string",
        "description": "Kilde som opprettet gruppen",
        "enum": [
          "EKSTERN",
          "INTERN"
        ]
      },
      "Bruker": {
        "type": "object",
        "properties": {
          "personId": {
            "$ref": "#/components/schemas/PersonId"
          },
          "fodselsnummer": {
            "$ref": "#/components/schemas/Fodselsnummer"
          },
          "aktiv": {
            "type": "boolean",
            "description": "Brukes for å aktivere / deaktivere bruker. Deaktivert bruker vil miste alle tilganger"
          },
          "eksternRef": {
            "$ref": "#/components/schemas/EksternRef"
          }
        },
        "required": [
          "personId",
          "fodselsnummer",
          "aktiv"
        ]
      },
      "Brukere": {
        "type": "object",
        "properties": {
          "brukere": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bruker"
            }
          }
        },
        "required": [
          "brukere"
        ]
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    },
    "responses": {
      "ugyldigParameterverdi": {
        "description": "Ugyldig input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ugyldig input",
              "status": 400
            }
          }
        }
      },
      "manglerTilgang": {
        "description": "Ugyldig tilgang",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ugyldig tilgang",
              "status": 403
            }
          }
        }
      },
      "ikkeFunnet": {
        "description": "Ikke funnet",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ikke funnet",
              "status": 404
            }
          }
        }
      }
    }
  }
}
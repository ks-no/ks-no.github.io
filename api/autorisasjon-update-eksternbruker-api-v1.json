{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Fiks: Autorisasjon update service for eksterne brukere",
    "description": "KS Fiks: Autorisasjon update for eksterne brukere tilknyttet en organisasjon",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ks.no"
    },
    "version": "v1",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://autorisasjon-update-service:8080",
      "description": "Cluster internal service URI"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "EksternBruker",
      "description": "API for administrasjon av eksterne brukere tilknyttet en organisasjon"
    }
  ],
  "paths": {
    "/autorisasjon-update/api/v1/organisasjoner/{fiksOrg}/ekstern/bruker/{eksternRef}": {
      "put": {
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksOrg"
          },
          {
            "$ref": "#/components/parameters/eksternRef"
          }
        ],
        "tags": [
          "EksternBruker"
        ],
        "operationId": "opprettEksternBruker",
        "description": "Oppretter ekstern bruker",
        "summary": "Oppretter ekstern bruker",
        "requestBody": {
          "description": "Opprett ny ekstern bruker",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpprettEksternBruker"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Aktor oppdatert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EksternBruker"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksOrg"
          },
          {
            "$ref": "#/components/parameters/eksternRef"
          }
        ],
        "tags": [
          "EksternBruker"
        ],
        "operationId": "oppdaterEksternBruker",
        "description": "Oppdaterer ekstern bruker",
        "summary": "Oppdaterer ekstern bruker",
        "requestBody": {
          "description": "Oppdater eksisterende ekstern bruker",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OppdaterEksternBruker"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Aktor oppdatert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EksternBruker"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksOrg"
          },
          {
            "$ref": "#/components/parameters/eksternRef"
          }
        ],
        "tags": [
          "EksternBruker"
        ],
        "operationId": "slettEksternBruker",
        "description": "Slett ekstern bruker",
        "summary": "Slett ekstern bruker (hard delete)",
        "responses": {
          "204": {
            "description": "Aktor slettet"
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "fiksOrg": {
        "name": "fiksOrg",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/FiksOrgId"
        }
      },
      "eksternRef": {
        "name": "eksternRef",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/EksternRef"
        }
      }
    },
    "responses": {
      "ugyldigParameterverdi": {
        "description": "Ugyldig input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "manglerTilgang": {
        "description": "Ikke autorisert",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ikke autorisert",
              "status": 403
            }
          }
        }
      }
    },
    "schemas": {
      "FiksOrgId": {
        "type": "string",
        "format": "uuid",
        "description": "Referanse til organisasjon",
        "example": "6bda5f6a-1425-45a9-88d9-8e2a7e455f0f"
      },
      "EksternRef": {
        "type": "string",
        "format": "uuid",
        "description": "Referanse til ekstern bruker",
        "example": "c434e529-446a-4aec-a51a-0636d3c4274b"
      },
      "Fodselsnummer": {
        "type": "string",
        "description": "Fødselsnummer fra folkeregisteret '12345678901'",
        "pattern": "^[0-9]{11}$",
        "example": "16328527115"
      },
      "OppdaterEksternBruker": {
        "type": "object",
        "properties": {
          "aktiv": {
            "type": "boolean",
            "description": "Brukes for å aktivere / deaktivere bruker. Deaktivert bruker vil miste alle tilganger"
          },
          "fodselsnummer": {
            "$ref": "#/components/schemas/Fodselsnummer"
          }
        }
      },
      "OpprettEksternBruker": {
        "type": "object",
        "properties": {
          "fodselsnummer": {
            "$ref": "#/components/schemas/Fodselsnummer"
          },
          "aktiv": {
            "type": "boolean",
            "description": "Brukes for å aktivere / deaktivere bruker. Deaktivert bruker vil miste alle tilganger"
          }
        },
        "required": [
          "aktiv",
          "fodselsnummer"
        ]
      },
      "EksternBruker": {
        "type": "object",
        "properties": {
          "eksternRef": {
            "$ref": "#/components/schemas/EksternRef"
          },
          "fodselsnummer": {
            "$ref": "#/components/schemas/Fodselsnummer"
          },
          "aktiv": {
            "type": "boolean",
            "description": "Indikerer om bruker er aktiv eller ikke",
            "example": true
          }
        },
        "required": [
          "eksternRef",
          "aktiv",
          "fodselsnummer"
        ]
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Fiks: Autorisasjon update service for grupper",
    "description": "KS Fiks: Autorisasjon update service",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ks.no"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://autorisasjon-update-service:8080",
      "description": "Cluster internal service URI"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Grupper",
      "description": "API for administrasjon av grupper"
    }
  ],
  "paths": {
    "/autorisasjon-update/api/v1/organisasjoner/{fiksOrg}/grupper": {
      "post": {
        "parameters": [
          {
            "name": "fiksOrg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Opprette gruppe",
        "summary": "Oppretter ny gruppe under fiksorg",
        "operationId": "opprettGruppe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpprettGruppeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Opprettet gruppe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gruppe"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      }
    },
    "/autorisasjon-update/api/v1/organisasjoner/{fiksOrg}/grupper/{gruppe}": {
      "put": {
        "parameters": [
          {
            "name": "fiksOrg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "gruppe",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Oppdaterer gruppe",
        "summary": "Oppdaterer gruppe",
        "operationId": "oppdaterGruppe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OppdaterGruppeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Gruppe er oppdatert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gruppe"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "fiksOrg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "gruppe",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Sletter gruppe",
        "summary": "Sletter gruppe",
        "operationId": "slettGruppe",
        "responses": {
          "201": {
            "description": "Gruppe er slettet"
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      }
    },
    "/autorisasjon-update/api/v1/organisasjoner/{fiksOrg}/grupper/{gruppe}/brukere": {
      "put": {
        "parameters": [
          {
            "name": "fiksOrg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "gruppe",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Legg brukere til gruppe",
        "summary": "Legg brukere til gruppe",
        "operationId": "leggTilBrukere",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeggTilBrukereRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Brukere er lagt til gruppe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gruppe"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "fiksOrg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "gruppe",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "tags": [
          "Grupper"
        ],
        "description": "Fjerner brukere fra gruppe",
        "summary": "Fjerner brukere fra gruppe",
        "operationId": "fjernBrukere",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FjernBrukereRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Brukere er fjernet fra gruppe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gruppe"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FjernBrukereRequest": {
        "type": "object",
        "properties": {
          "brukere": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "description": "Brukere som skal fjernes fra gruppen",
            "items": {
              "$ref": "#/components/schemas/EksternRef"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "brukere"
        ]
      },
      "LeggTilBrukereRequest": {
        "type": "object",
        "properties": {
          "brukere": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "description": "Brukere som skal legges til gruppen",
            "items": {
              "$ref": "#/components/schemas/EksternRef"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "brukere"
        ]
      },
      "EksternRef": {
        "type": "string",
        "format": "uuid",
        "description": "Referanse til ekstern bruker",
        "example": "c434e529-446a-4aec-a51a-0636d3c4274b"
      },
      "OpprettGruppeRequest": {
        "type": "object",
        "properties": {
          "navn": {
            "$ref": "#/components/schemas/GruppeNavn"
          },
          "eksternRef": {
            "$ref": "#/components/schemas/EksternRef"
          }
        },
        "required": [
          "navn"
        ]
      },
      "Gruppe": {
        "type": "object",
        "properties": {
          "navn": {
            "$ref": "#/components/schemas/GruppeNavn"
          },
          "id": {
            "type": "string",
            "description": "Gruppe id",
            "format": "uuid"
          },
          "kilde": {
            "$ref": "#/components/schemas/GruppeKilde"
          },
          "brukere": {
            "type": "array",
            "minItems": 0,
            "description": "Brukere som er tilknyttet gruppen",
            "items": {
              "$ref": "#/components/schemas/EksternRef"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "navn",
          "id",
          "kilde",
          "brukere"
        ]
      },
      "OppdaterGruppeRequest": {
        "type": "object",
        "properties": {
          "navn": {
            "$ref": "#/components/schemas/GruppeNavn"
          }
        },
        "required": [
          "navn"
        ]
      },
      "GruppeKilde": {
        "type": "string",
        "description": "Kilde som opprettet gruppen",
        "enum": [
          "EKSTERN",
          "INTERN"
        ]
      },
      "GruppeNavn": {
        "type": "string",
        "description": "Visningsnavn på gruppe",
        "maxLength": 200,
        "minLength": 1
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    },
    "responses": {
      "ugyldigParameterverdi": {
        "description": "Ugyldig input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "manglerTilgang": {
        "description": "Ugyldig tilgang",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ugyldig tilgang",
              "status": 403
            }
          }
        }
      }
    }
  }
}
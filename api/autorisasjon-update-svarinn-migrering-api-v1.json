{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Fiks: Svarinn - Resource Migration API",
    "description": "KS Fiks: Svarinn temporary API for resource creation with predefined ID during migration",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ks.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://autorisasjon-update-service:8080",
      "description": "Cluster internal service URI"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Svarinn",
      "description": "API for Svarinn resource migration"
    }
  ],
  "paths": {
    "/autorisasjon-update/api/v1/svarinn/ressurs": {
      "post": {
        "deprecated": true,
        "tags": [
          "Svarinn"
        ],
        "description": "Creates a Svarinn resource with predefined ID for migration. This endpoint is only for time-limited Svarinn migration.",
        "summary": "Create Svarinn resource with predefined ID",
        "operationId": "svarinnOpprettRessurs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpprettRessursForMigreringRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Opprettet Ressurs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ressurs"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "ugyldigParameterverdi": {
        "description": "Feil i inputdata",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "manglerTilgang": {
        "description": "Ugyldig tilgang",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ugyldig tilgang",
              "status": 403
            }
          }
        }
      }
    },
    "schemas": {
      "Ressurs": {
        "required": [
          "forelder",
          "id",
          "navn",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Ressursens ID",
            "format": "uuid"
          },
          "forelder": {
            "type": "string",
            "description": "UUID til ressursens forelderressurs",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "description": "Ressursens type"
          },
          "navn": {
            "type": "string",
            "description": "Ressursens visningsnavn"
          }
        },
        "description": "Representerer en ressurs, som er en entitet som kan tilordnes privilegier."
      },
      "OpprettRessursForMigreringRequest": {
        "required": [
          "id",
          "forelderRessurs",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Forhåndsdefinert ressurs-ID som skal brukes ved opprettelse",
            "format": "uuid"
          },
          "forelderRessurs": {
            "type": "string",
            "description": "UUID til ressursens forelderressurs",
            "format": "uuid"
          },
          "type": {
            "pattern": "^[0-9A-Z_.]+$",
            "type": "string",
            "description": "Ressursens type"
          },
          "navn": {
            "maxLength": 200,
            "minLength": 2,
            "pattern": "^[A-ZÆØÅa-zæøå0-9ÁáÀàÂâÉéÈèÊêÍíÌìÎîÓóÒòÔôÚúÙùÛûÝýÄäËëÏïÖöÜü,.!?\\-:;/\\\\'()&+*=%§]+[A-ZÆØÅa-zæøå0-9ÁáÀàÂâÉéÈèÊêÍíÌìÎîÓóÒòÔôÚúÙùÛûÝýÄäËëÏïÖöÜü ,.!?\\-:;/\\\\'()&+*=%§]*[A-ZÆØÅa-zæøå0-9ÁáÀàÂâÉéÈèÊêÍíÌìÎîÓóÒòÔôÚúÙùÛûÝýÄäËëÏïÖöÜü,.!?\\-:;/\\\\'()&+*=%§]+$",
            "type": "string",
            "description": "Ressursens visningsnavn"
          },
          "tilganger": {
            "$ref": "#/components/schemas/TilgangBulkRequest"
          }
        },
        "description": "En request for å opprette en ny ressurs med forhåndsdefinert ID"
      },
      "TilgangBulkRequest": {
        "required": [
          "tilganger"
        ],
        "type": "object",
        "properties": {
          "tilganger": {
            "type": "array",
            "description": "Liste over tilganger som skal opprettes samtidig med ressursen",
            "items": {
              "$ref": "#/components/schemas/TilgangRequest"
            }
          }
        },
        "description": "Representerer en rekke autorisasjoner som ønskes tildelt"
      },
      "TilgangRequest": {
        "required": [
          "aktor",
          "privilegium"
        ],
        "type": "object",
        "properties": {
          "aktor": {
            "type": "string",
            "description": "Aktør-ID som skal tildeles privilegium"
          },
          "privilegium": {
            "type": "string",
            "description": "Privilegium som skal tildeles aktøren"
          }
        },
        "description": "Representerer en tilgang som skal knyttes til ressursen"
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
{
  "openapi": "3.0.1",
  "info": {
    "title": "KS FIKS: BRREG Service",
    "description": "BRREG Proxy service",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://www.ks.no/fagomrader/digitalisering/utviklingsprosjekter/",
      "email": "fiks@ksdigital.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.test.ks.no",
      "description": "KS Fiks API host"
    }
  ],
  "tags": [
    {
      "name": "Brreg",
      "description": "API for henting av enheter fra enhetsregisteret i Brønnøysund"
    }
  ],
  "paths": {
    "/brreg/api/brreg/enhet/{orgnr}/eksisterer": {
      "get": {
        "tags": [
          "Brreg"
        ],
        "description": "Endepunkt som verifiserer om enhet eksisterer",
        "operationId": "eksisterer",
        "deprecated": true,
        "parameters": [
          {
            "name": "orgnr",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^\\d{9}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Dersom enhet eksisterer"
          },
          "404": {
            "description": "Dersom enhet ikke eksisterer"
          }
        }
      }
    },
    "/brreg/api/brreg/enhet/{orgnr}": {
      "get": {
        "tags": [
          "Brreg"
        ],
        "description": "Henter orgnr",
        "operationId": "hentEnhet",
        "deprecated": true,
        "parameters": [
          {
            "name": "orgnr",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^\\d{9}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organisasjonsenhet fra BRREG",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enhet"
                }
              }
            }
          },
          "401": {
            "description": "Ingen enhet ble funnet for det oppgitte orgnr"
          }
        }
      }
    },
    "/brreg/api/brreg/enhet": {
      "get": {
        "tags": [
          "Brreg"
        ],
        "description": "Henter enheter",
        "operationId": "hentEnheter",
        "deprecated": true,
        "parameters": [
          {
            "name": "orgnr",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Enheter som samsvarer med orgnr",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Enhet"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/brreg/api/brreg/enhet/sok": {
      "get": {
        "tags": [
          "Brreg"
        ],
        "description": "Henter enheter",
        "operationId": "soekEnheter",
        "deprecated": true,
        "parameters": [
          {
            "name": "navn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Søk på enheter etter navn",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Enhet"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/brreg/api/brreg/enhet/{underenhetOrgnr}/underenhet/{orgnr}": {
      "get": {
        "tags": [
          "Brreg"
        ],
        "description": "Endepunkt som verifiserer om enhet er underenhet av annen enhet",
        "operationId": "underenhet",
        "deprecated": true,
        "parameters": [
          {
            "name": "underenhetOrgnr",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^\\d{9}$",
              "type": "string"
            }
          },
          {
            "name": "orgnr",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^\\d{9}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dersom underenhet eksisterer. True dersom underenhetOrgnr ligger under orgnr, false ellers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "404": {
            "description": "Dersom underenhet ikke eksisterer"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Adresse": {
        "type": "object",
        "properties": {
          "adresse": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postnummer": {
            "type": "string"
          },
          "poststed": {
            "type": "string"
          },
          "land": {
            "type": "string"
          },
          "landkodeTosifret": {
            "type": "string"
          },
          "landkodeTrestifret": {
            "type": "string"
          },
          "kommunenummer": {
            "type": "string"
          },
          "adresselinje1": {
            "type": "string"
          },
          "adresselinje2": {
            "type": "string"
          },
          "adresselinje3": {
            "type": "string"
          }
        }
      },
      "Enhet": {
        "type": "object",
        "properties": {
          "organisasjonsnummer": {
            "type": "string"
          },
          "navn": {
            "type": "string"
          },
          "postadresse": {
            "$ref": "#/components/schemas/Adresse"
          },
          "forretningsadresse": {
            "$ref": "#/components/schemas/Adresse"
          },
          "overordnetEnhet": {
            "type": "string"
          },
          "institusjonellSektorkode": {
            "$ref": "#/components/schemas/InstitusjonellSektorkode"
          },
          "fiksOrgType": {
            "type": "string"
          },
          "foretrukketBrevadresse": {
            "$ref": "#/components/schemas/Adresse"
          }
        }
      },
      "InstitusjonellSektorkode": {
        "type": "object",
        "properties": {
          "kode": {
            "type": "string"
          },
          "beskrivelse": {
            "type": "string"
          }
        }
      }
    }
  }
}
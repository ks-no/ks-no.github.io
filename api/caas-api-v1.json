{
  "openapi": "3.0.3",
  "info": {
    "title": "KS FIKS: CaaS service",
    "description": "Configuration as a Service (CaaS)",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://www.ks.no/fagomrader/digitalisering/utviklingsprosjekter",
      "email": "fiks-utvikling@ks.no"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.ks.no",
      "description": "KS Fiks API host"
    },
    {
      "url": "https://api.test.fiks.ks.no",
      "description": "KS Fiks TEST API host"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "caas",
      "description": "API for konfigurasjon som tjeneste (CaaS)"
    }
  ],
  "paths": {
    "/caas/api/v1/konfigurasjon/{fiksOrgId}/tjeneste/{tjeneste}": {
      "get": {
        "tags": [
          "caas"
        ],
        "summary": "Hent konfigurasjon for en tjeneste",
        "description": "Henter lagret konfigurasjon for en gitt tjeneste under en FIKS-organisasjon",
        "operationId": "hentKonfigurasjon",
        "parameters": [
          {
            "name": "fiksOrgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "tjeneste",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Konfigurasjon funnet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Konfigurasjon"
                }
              }
            }
          },
          "400": {
            "description": "Ukjent tjeneste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autorisert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen konfigurasjon funnet for denne tjenesten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "caas"
        ],
        "summary": "Sett konfigurasjon for en tjeneste",
        "description": "Setter (oppretter eller overskriver) konfigurasjon for en gitt tjeneste under en FIKS-organisasjon. Payload valideres ikke i denne omgangen.",
        "operationId": "settKonfigurasjon",
        "parameters": [
          {
            "name": "fiksOrgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "tjeneste",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Konfigurasjon"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Konfigurasjon lagret"
          },
          "400": {
            "description": "Ukjent tjeneste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autorisert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "errorId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "errorCode": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          },
          "httpStatus": {
            "type": "integer"
          }
        }
      },
      "Konfigurasjon": {
        "description": "Vilkårlig JSON-struktur. Valideres ikke i denne omgangen — vil senere kunne styres av et schema per tjeneste.",
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
{
  "openapi": "3.0.3",
  "info": {
    "title": "KS FIKS: Eiendomsavtaler synk-api",
    "description": "Internt API brukt av eiendomsavtaler-sync-service til bulk-innlasting av matrikkeldata og kunder fra Matrikkelen. Ikke ment for andre konsumenter.",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ksdigital.no/om-oss/kontakt-oss",
      "email": "fiks@ksdigital.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.ks.no",
      "description": "KS Fiks API host"
    },
    {
      "url": "https://api.fiks.test.ks.no",
      "description": "KS Fiks TEST API host"
    }
  ],
  "tags": [
    {
      "name": "Eiendomsavtale synk",
      "description": "Internt bulk-/synk-API for eiendomsavtaler. Brukes av `eiendomsavtaler-sync-service` til å avstemme lokalt lagrede hovedavtaler mot Matrikkelen."
    },
    {
      "name": "Kunde synk",
      "description": "Internt bulk-API for kunder. Brukes av `eiendomsavtaler-sync-service` til å opprette og oppdatere kunder fra Matrikkelen."
    }
  ],
  "paths": {
    "/eiendomsavtaler/api/v1/eiendomsavtaler/bulk": {
      "post": {
        "description": "Opprett eller oppdater eiendomsavtaler i bulk (upsert). Eksisterende avtaler oppdateres basert på alternativId, fraværende opprettes.",
        "operationId": "bulkUpsertEiendomsavtaler",
        "tags": [
          "Eiendomsavtale synk"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EiendomsavtaleBulkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vellykket bulk operasjon"
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/eiendomsavtaler/api/v1/eiendomsavtaler/full-synk": {
      "post": {
        "description": "Trigger en full resync av eiendomsavtaler uten å nuke databasen. Nullstiller HWM-markøren slik at den planlagte EiendomsavtalerJob replayer hele endringsloggen ved neste kjøring. Krever ADMIN-privilegium på ROOT.",
        "operationId": "startFullSynkEiendomsavtaler",
        "tags": [
          "Eiendomsavtale synk"
        ],
        "responses": {
          "204": {
            "description": "Full synk startet. HWM er nullstilt; replay skjer ved neste jobb-kjøring."
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/eiendomsavtaler/api/v1/kunder/bulk": {
      "put": {
        "tags": [
          "Kunde synk"
        ],
        "description": "Opprett eller oppdater flere kunder i bulk (upsert). Eksisterende kunder oppdateres basert på offentligId, nye kunder opprettes. OffentligId må være unikt for hver kunde i systemet.",
        "operationId": "bulkUpsertKunder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KundeBulkUpsertRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultat av bulk upsert operasjonen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KundeBulkUpsertResultAPIModel"
                }
              }
            }
          },
          "400": {
            "description": "Ugyldig forespørsel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/eiendomsavtaler/api/v1/kunder/bulk-oppdater": {
      "put": {
        "tags": [
          "Kunde synk"
        ],
        "description": "Oppdater flere eksisterende kunder i bulk basert på offentligId. Kunder som ikke finnes fra før blir ignorert (ingen nye kunder opprettes).",
        "operationId": "bulkOppdaterKunder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KundeBulkUpsertRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultat av bulk oppdater operasjonen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KundeBulkUpsertResultAPIModel"
                }
              }
            }
          },
          "400": {
            "description": "Ugyldig forespørsel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/eiendomsavtaler/api/v1/kunder/backfill-personkategori": {
      "put": {
        "tags": [
          "Kunde backfill"
        ],
        "description": "Setter personkategori på eksisterende annen-kunder basert på offentligId. Endrer ikke sistEndret. Kunder som ikke finnes, eller ikke er annen-kunder, blir ignorert. Tiltenkt å unngå å lage nye endringslogger for kunder som får etterfylt personkategori.",
        "operationId": "backfillPersonkategori",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonkategoriBulkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultat av bulk personkategori operasjonen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonkategoriBulkResultAPIModel"
                }
              }
            }
          },
          "400": {
            "description": "Ugyldig forespørsel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PersonkategoriBulkRequest": {
        "type": "object",
        "properties": {
          "kunder": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonkategoriRequest"
            }
          }
        },
        "required": [
          "kunder"
        ]
      },
      "PersonkategoriRequest": {
        "type": "object",
        "properties": {
          "offentligId": {
            "type": "string"
          },
          "personKategoriKodeId": {
            "type": "integer",
            "format": "int64"
          },
          "personKategoriVisningsnavn": {
            "type": "string"
          }
        },
        "required": [
          "offentligId",
          "personKategoriKodeId",
          "personKategoriVisningsnavn"
        ]
      },
      "PersonkategoriBulkResultAPIModel": {
        "type": "object",
        "properties": {
          "antallSatt": {
            "type": "integer",
            "format": "int32",
            "description": "Antall kunder som fikk personkategori satt."
          }
        },
        "required": [
          "antallSatt"
        ]
      },
      "EiendomsavtaleBulkRequest": {
        "type": "object",
        "properties": {
          "matrikkeldata": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatrikkeldataAPIModel"
            }
          }
        },
        "required": [
          "matrikkeldata"
        ]
      },
      "KundeBulkRequest": {
        "type": "object",
        "properties": {
          "offentligId": {
            "type": "string",
            "description": "Fødselsnummer, organisasjonsnummer eller annen ID."
          },
          "kundetype": {
            "$ref": "#/components/schemas/KundeTypeAPIModel"
          },
          "navn": {
            "type": "string"
          },
          "fornavn": {
            "type": "string"
          },
          "etternavn": {
            "type": "string"
          },
          "postadresse": {
            "$ref": "#/components/schemas/PostadresseAPIModel"
          },
          "forretningsadresse": {
            "$ref": "#/components/schemas/PostadresseAPIModel"
          },
          "gyldigFra": {
            "type": "string",
            "format": "date"
          },
          "gyldigTil": {
            "type": "string",
            "format": "date"
          },
          "personstatus": {
            "$ref": "#/components/schemas/PersonstatusAPIModel"
          },
          "personstatusVisningsnavn": {
            "type": "string"
          },
          "personKategoriKodeId": {
            "type": "integer",
            "format": "int64"
          },
          "personKategoriVisningsnavn": {
            "type": "string"
          }
        },
        "required": [
          "offentligId",
          "kundetype"
        ]
      },
      "KundeBulkUpsertRequest": {
        "type": "object",
        "description": "Forespørsel for bulk upsert av kunder. Eksisterende kunder oppdateres basert på offentligId, nye kunder opprettes.",
        "properties": {
          "kunder": {
            "type": "array",
            "description": "Liste over kunder som skal opprettes eller oppdateres. Listen kan inneholde mellom 1 og 100 elementer.",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/KundeBulkRequest"
            }
          }
        },
        "required": [
          "kunder"
        ]
      },
      "KundeBulkUpsertResultAPIModel": {
        "type": "object",
        "description": "Resultat av en bulk upsert operasjon på kunder.",
        "properties": {
          "opprettet": {
            "type": "array",
            "description": "Kunder som ble opprettet.",
            "items": {
              "$ref": "#/components/schemas/KundeAPIModel"
            }
          },
          "oppdatert": {
            "type": "array",
            "description": "Kunder som ble oppdatert.",
            "items": {
              "$ref": "#/components/schemas/KundeAPIModel"
            }
          },
          "antallOpprettet": {
            "type": "integer",
            "format": "int32",
            "description": "Antall kunder som ble opprettet."
          },
          "antallOppdatert": {
            "type": "integer",
            "format": "int32",
            "description": "Antall kunder som ble oppdatert."
          }
        },
        "required": [
          "opprettet",
          "oppdatert",
          "antallOpprettet",
          "antallOppdatert"
        ]
      },
      "MatrikkeldataAPIModel": {
        "type": "object",
        "properties": {
          "kommunenummer": {
            "type": "string"
          },
          "gardsnummer": {
            "type": "integer",
            "format": "int32"
          },
          "bruksnummer": {
            "type": "integer",
            "format": "int32"
          },
          "festenummer": {
            "type": "integer",
            "format": "int32"
          },
          "seksjonsnummer": {
            "type": "integer",
            "format": "int32"
          },
          "erSeksjonert": {
            "type": "boolean"
          },
          "erUtgatt": {
            "type": "boolean"
          },
          "etableringsdato": {
            "type": "string",
            "format": "date"
          },
          "eiendomsadresser": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EiendomsadresseAPIModel"
            }
          },
          "eierforhold": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EierForholdAPIModel"
            }
          }
        },
        "required": [
          "kommunenummer",
          "gardsnummer",
          "bruksnummer",
          "festenummer",
          "seksjonsnummer",
          "erSeksjonert",
          "erUtgatt"
        ]
      },
      "EiendomsadresseAPIModel": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "adressetype": {
            "type": "string",
            "enum": [
              "MATRIKKELADRESSE",
              "VEGADRESSE",
              "AVTALEADRESSE",
              "UKJENT"
            ]
          },
          "kortnavn": {
            "type": "string"
          },
          "adressetilleggsnavn": {
            "type": "string"
          },
          "nummer": {
            "type": "integer"
          },
          "bokstav": {
            "type": "string"
          },
          "adressenavn": {
            "type": "string"
          },
          "kortAdressenavn": {
            "type": "string"
          },
          "stedsnummer": {
            "type": "string"
          },
          "kommunenummer": {
            "type": "string"
          },
          "bruksenhetsnummer": {
            "type": "string"
          },
          "postnummer": {
            "type": "string"
          },
          "poststed": {
            "type": "string"
          }
        },
        "required": [
          "adressetype",
          "adressenavn",
          "kommunenummer"
        ],
        "description": "Adresser tilknyttet eiendomsavtalen, feltene avhenger av AdresseModell fra eiendomsregister.modeller, og er en kombinasjon av felter fra Adresse, Veg og Kommune"
      },
      "EierForholdAPIModel": {
        "type": "object",
        "properties": {
          "kunde": {
            "type": "object",
            "properties": {
              "offentligId": {
                "type": "string",
                "description": "Fødselsnummer, organisasjonsnummer eller annen ID for kunden"
              }
            },
            "required": [
              "offentligId"
            ]
          },
          "andel": {
            "$ref": "#/components/schemas/AndelAPIModel"
          },
          "eierforholdType": {
            "type": "string",
            "enum": [
              "KONTAKTINSTANS",
              "PERSON_IKKE_TINGLYST",
              "MATRIKKELENHET_IKKE_TINGLYST",
              "PERSON_TINGLYST",
              "MATRIKKELENHET_TINGLYST",
              "SKATT_REGISTRERT",
              "INDIREKTE_EIERFORHOLD"
            ],
            "description": "Type eierforhold registrert i matrikkelen."
          },
          "eierforholdKode": {
            "type": "string",
            "enum": [
              "HJEMMELSHAVER",
              "FESTER",
              "FRAMFESTER",
              "FRAMFESTER_2",
              "FRAMFESTER_3",
              "FRAMFESTER_4",
              "FRAMFESTER_5",
              "FRAMFESTER_6",
              "FRAMFESTER_7",
              "FRAMFESTER_8",
              "FRAMFESTER_9",
              "AKTUELL_EIER",
              "AKTUELL_FESTER",
              "KONTAKTINSTANS_EIER",
              "KONTAKTINSTANS_FESTER",
              "KOMMUNAL_KONTAKTINSTANS_1",
              "KOMMUNAL_KONTAKTINSTANS_2",
              "KOMMUNAL_KONTAKTINSTANS_3",
              "SKATTEETATEN_EIER",
              "SKATTEETATEN_FESTER",
              "SKATTEETATEN_FRAMFESTER",
              "SKATTEETATEN_FRAMFESTER_2",
              "SKATTEETATEN_FRAMFESTER_3",
              "UKJENT"
            ],
            "description": "Matrikkelens eierforholdKode (mappet fra kodeverdi, f.eks. H/F/F1…). Sier hva slags eier det er — hjemmelshaver, fester, framfester osv. — og brukes til å prioritere mellom flere kandidater ved valg av eierkontakt. Uavhengig akse fra både eierforholdType og eierens rolle."
          },
          "eierforholdKodeVisningsnavn": {
            "type": "string",
            "description": "Matrikkelens visningsnavn for eierforholdKode, f.eks. «Framfester 2». Bevares slik at en kode vi ennå ikke har mappet (UKJENT) fortsatt kan vises meningsfullt."
          },
          "fraDato": {
            "type": "string",
            "format": "date"
          },
          "tilDato": {
            "type": "string",
            "format": "date"
          },
          "oppdateringsdato": {
            "type": "string",
            "format": "date"
          },
          "eierforholdUuid": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for eierforholdet."
          },
          "opprinneligEierforholdUuid": {
            "type": "string",
            "format": "uuid",
            "description": "Kun satt for INDIREKTE_EIERFORHOLD: UUID-en til det opprinnelige eierforholdet i eiendomsregisteret denne indirekte eieren er avledet fra, for sporbarhet."
          }
        },
        "required": [
          "kunde",
          "eierforholdType"
        ]
      },
      "AndelAPIModel": {
        "type": "object",
        "properties": {
          "teller": {
            "type": "integer",
            "format": "int64"
          },
          "nevner": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "teller",
          "nevner"
        ]
      },
      "PostadresseAPIModel": {
        "type": "object",
        "properties": {
          "adresselinje1": {
            "type": "string"
          },
          "adresselinje2": {
            "type": "string"
          },
          "adresselinje3": {
            "type": "string"
          },
          "postnummer": {
            "type": "string"
          },
          "poststed": {
            "type": "string"
          }
        }
      },
      "KundeAPIModel": {
        "type": "object",
        "properties": {
          "kundeId": {
            "type": "string",
            "format": "uuid"
          },
          "offentligId": {
            "type": "string",
            "description": "Fødselsnummer, organisasjonsnummer eller annen ID."
          },
          "kundetype": {
            "$ref": "#/components/schemas/KundeTypeAPIModel"
          },
          "navn": {
            "type": "string"
          },
          "fornavn": {
            "type": "string"
          },
          "etternavn": {
            "type": "string"
          },
          "postadresse": {
            "$ref": "#/components/schemas/PostadresseAPIModel"
          },
          "gyldigFra": {
            "type": "string",
            "format": "date"
          },
          "gyldigTil": {
            "type": "string",
            "format": "date"
          },
          "sistEndret": {
            "type": "string",
            "format": "date-time",
            "description": "Tidspunkt da eiendomsavtalen sist ble oppdatert"
          },
          "personstatus": {
            "$ref": "#/components/schemas/PersonstatusAPIModel"
          },
          "personstatusVisningsnavn": {
            "type": "string"
          },
          "personKategoriKodeId": {
            "type": "integer",
            "format": "int64"
          },
          "personKategoriVisningsnavn": {
            "type": "string"
          }
        },
        "required": [
          "kundeId",
          "offentligId",
          "kundetype",
          "navn",
          "postadresse",
          "sistEndret"
        ]
      },
      "KundeTypeAPIModel": {
        "type": "string",
        "enum": [
          "PERSON",
          "ORGANISASJON",
          "ANNEN"
        ]
      },
      "PersonstatusAPIModel": {
        "type": "string",
        "enum": [
          "IKKE_OPPGITT",
          "BOSATT_I_NORGE",
          "AKTIV_PERSON_MED_D_NR",
          "UTVANDRET",
          "FORSVUNNET",
          "DOD",
          "UTGATT",
          "FODSELSREGISTRERT",
          "ANNULERT",
          "UREGISTRERT",
          "MIDLERTIDIG",
          "INAKTIV",
          "IKKE_BOSATT",
          "AKTIV",
          "UKJENT"
        ]
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {

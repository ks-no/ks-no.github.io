{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "KS Fiks: FIKS IO Root Service",
    "description" : "KS Fiks: FIKS IO Root Service",
    "contact" : {
      "name" : "Fiks brukerstøtte",
      "url" : "https://www.ks.no/fagomrader/digitalisering/utviklingsprosjekter/",
      "email" : "fiks@ks.no"
    },
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "https://api.fiks.test.ks.no",
    "description" : "KS Fiks API host"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "FiksIORoot",
    "description" : "API for å behandle kontoer i Fiks IO"
  } ],
  "paths" : {
    "/fiks-io/root/api/v1/kontoer" : {
      "get" : {
        "tags" : [ "FiksIORoot" ],
        "description" : "Henter alle kontoer",
        "operationId" : "kontoStatuser",
        "responses" : {
          "200" : {
            "description" : "Alle kontoer",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/KontoStatusViewResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Krever ROOT tilgang",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/fiks-io/root/api/v1/kontoer/{kontoId}/queue" : {
      "get" : {
        "tags" : [ "FiksIORoot" ],
        "description" : "Henter status for kø fra RabbitMQ",
        "operationId" : "queueStats",
        "parameters" : [ {
          "name" : "kontoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Kø opprettet (om den ikke fantes) eller bare sjekket at den finnes",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/KontoQueueStatusApiModel"
                }
              }
            }
          },
          "403" : {
            "description" : "Krever ROOT tilgang",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404" : {
            "description" : "Kontoen finnes ikke",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "FiksIORoot" ],
        "description" : "Oppretter kø på nytt dersom den ikke finnes",
        "operationId" : "recreateQueue",
        "parameters" : [ {
          "name" : "kontoId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Kø opprettet (om den ikke fantes) eller bare sjekket at den finnes",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/KontoQueueStatusApiModel"
                }
              }
            }
          },
          "403" : {
            "description" : "Krever ROOT tilgang",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404" : {
            "description" : "Kontoen finnes ikke",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "https://developers.fiks.ks.no/api/fiks-common.json#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "KontoQueueStatusApiModel" : {
        "type" : "object",
        "required" : [ "queueExists", "queueName" ],
        "properties" : {
          "queueExists" : {
            "type" : "boolean"
          },
          "queueName" : {
            "type" : "string"
          },
          "ventendeMeldinger" : {
            "type" : "integer",
            "format" : "int64"
          },
          "antallKonsumenter" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "KontoStatus" : {
        "type" : "object",
        "required" : [ "fiksOrgId", "fiksOrgNavn", "kontoId", "kontoNavn", "opprettet", "status" ],
        "properties" : {
          "fiksOrgId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "fiksOrgNavn" : {
            "type" : "string"
          },
          "kontoId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kontoNavn" : {
            "type" : "string"
          },
          "opprettet" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "$ref" : "#/components/schemas/KontoQueueStatusApiModel"
          }
        }
      },
      "KontoStatusViewResponse" : {
        "type" : "object",
        "required" : [ "kontoer" ],
        "properties" : {
          "kontoer" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/KontoStatus"
            }
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}

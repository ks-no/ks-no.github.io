{
  "openapi": "3.0.1",
  "info": {
    "title": "KS SvarUt: Status API",
    "description": "API for henting av status for forsendelser",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ksdigital.no"
    },
    "version": "v2"
  },
  "servers": [
    {
      "url": "https://test.svarut.ks.no/api",
      "description": "SvarUt testmiljø"
    },
    {
      "url": "https://svarut.ks.no/api",
      "description": "SvarUt produksjonsmiljø"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Status",
      "description": "API for henting av status for forsendelser"
    }
  ],
  "paths": {
    "/v2/kontoer/{kontoId}/forsendelser/status-sok": {
      "post": {
        "tags": [
          "Status"
        ],
        "summary": "Hent status for forsendelser",
        "description": "Henter status for forsendelse",
        "operationId": "hentStatuser",
        "parameters": [
          {
            "name": "kontoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/StatusSok"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Status for forsendelser",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForsendelseStatuser"
                }
              }
            }
          },
          "default": {
            "description": "Feil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ForsendelseStatus": {
        "required": [
          "id",
          "sisteStatusEndring",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Forsendelse id denne statusen gjelder",
            "format": "uuid",
            "example": "d6b23522-ddf3-462a-8140-16e59e1f476d"
          },
          "sisteStatusEndring": {
            "type": "string",
            "description": "Tidspunkt for siste endring av status",
            "format": "date-time",
            "example": "2023-01-01T11:33:55.008+01:00"
          },
          "status": {
            "type": "string",
            "description": "Gyldige statuser for en forsendelse",
            "example": "LEST",
            "enum": [
              "MOTTATT",
              "AKSEPTERT",
              "AVVIST",
              "VARSLET",
              "LEST",
              "SENDT_PRINT",
              "PRINTET",
              "MANUELT_HANDTERT",
              "SENDT_DIGITALT",
              "SENDT_SDP",
              "LEVERT_SDP",
              "KLAR_FOR_MOTTAK",
              "IKKE_LEVERT"
            ]
          }
        },
        "description": "Liste over status for hver forsendelse"
      },
      "ForsendelseStatuser": {
        "required": [
          "statuser"
        ],
        "type": "object",
        "properties": {
          "statuser": {
            "type": "array",
            "description": "Liste over status for hver forsendelse",
            "items": {
              "$ref": "#/components/schemas/ForsendelseStatus"
            }
          }
        }
      },
      "StatusSok": {
        "required": [
          "forsendelseIds"
        ],
        "type": "object",
        "properties": {
          "forsendelseIds": {
            "maxItems": 1000,
            "minItems": 1,
            "type": "array",
            "description": "Liste med forsendelseids man ønsker å søke etter",
            "items": {
              "type": "string",
              "description": "Liste med forsendelseids man ønsker å søke etter",
              "format": "uuid"
            }
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
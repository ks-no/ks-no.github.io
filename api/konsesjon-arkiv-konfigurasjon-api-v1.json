{
  "openapi": "3.0.3",
  "info": {
    "title": "KS FIKS: Konsesjon konfigurasjon API",
    "description": "API for konfigurasjon av Konsesjon-tjenesten, herunder valg av Fiks Arkiv-konto for arkivering.",
    "contact": {
      "name": "Fiks konsesjon",
      "url": "https://www.ks.no/fagomrader/digitalisering/utviklingsprosjekter",
      "email": "fiks-utvikling@ksdigital.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.ks.no",
      "description": "KS Fiks API host"
    },
    {
      "url": "https://api.test.fiks.ks.no",
      "description": "KS Fiks TEST API host"
    }
  ],
  "tags": [
    {
      "name": "ArkivKonfigurasjon",
      "description": "Konfigurasjon av Fiks Arkiv-integrasjon for Konsesjon"
    },
    {
      "name": "KonfigurasjonStatus",
      "description": "Status for kommunens konfigurasjon av Fiks konsesjon"
    }
  ],
  "paths": {
    "/konsesjon-api/v1/konfigurasjon/{fiksOrgId}/arkiv/kontoer": {
      "get": {
        "tags": [
          "ArkivKonfigurasjon"
        ],
        "summary": "Hent tilgjengelige Fiks Arkiv-kontoer",
        "description": "Henter alle Fiks Arkiv-kontoer for kommunen som er av relevante part-typer for arkivsiden. Kontoer med klient-parter ekskluderes.",
        "operationId": "hentArkivKontoer",
        "parameters": [
          {
            "in": "path",
            "name": "fiksOrgId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FiksOrgId"
            },
            "description": "Fiks organisasjons-ID for kommunen"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste over tilgjengelige Fiks Arkiv-kontoer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ArkivKontoSammendrag"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon-api/v1/konfigurasjon/{fiksOrgId}/arkiv/kontoer/{kontoId}/valider": {
      "post": {
        "tags": [
          "ArkivKonfigurasjon"
        ],
        "summary": "Valider valgt Fiks Arkiv-konto",
        "description": "Sjekker at den oppgitte Fiks Arkiv-kontoen er gyldig og tilgjengelig for bruk. Returnerer 200 OK hvis kontoen er gyldig.",
        "operationId": "validerArkivKonto",
        "parameters": [
          {
            "in": "path",
            "name": "fiksOrgId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FiksOrgId"
            },
            "description": "Fiks organisasjons-ID for kommunen"
          },
          {
            "in": "path",
            "name": "kontoId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ArkivKontoId"
            },
            "description": "ID for Fiks Arkiv-kontoen som skal valideres"
          }
        ],
        "responses": {
          "200": {
            "description": "Kontoen er gyldig og kan benyttes"
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Fant ikke Fiks Arkiv-kontoen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon-api/v1/konfigurasjon/{fiksOrgId}/arkiv/konto": {
      "get": {
        "tags": [
          "ArkivKonfigurasjon"
        ],
        "summary": "Hent valgt Fiks Arkiv-konto med status",
        "description": "Returnerer den konfigurerte Fiks Arkiv-kontoen for konsesjon, inkludert status som antall meldinger på kø og antall aktive konsumenter.",
        "operationId": "hentKonfigurertArkivKonto",
        "parameters": [
          {
            "in": "path",
            "name": "fiksOrgId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FiksOrgId"
            },
            "description": "Fiks organisasjons-ID for kommunen"
          }
        ],
        "responses": {
          "200": {
            "description": "Konfigurert Fiks Arkiv-konto med status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArkivKontoMedStatus"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen Fiks Arkiv-konto er konfigurert ennå",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "ArkivKonfigurasjon"
        ],
        "summary": "Sett Fiks Arkiv-konto for konsesjon",
        "description": "Erstatter konfigurasjonen for hvilken Fiks Arkiv-konto konsesjon skal arkivere til.",
        "operationId": "settArkivKonto",
        "parameters": [
          {
            "in": "path",
            "name": "fiksOrgId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FiksOrgId"
            },
            "description": "Fiks organisasjons-ID for kommunen"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettArkivKontoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Konfigurasjonen er oppdatert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArkivKontoMedStatus"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Fant ikke den oppgitte Fiks Arkiv-kontoen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon-api/v1/konfigurasjon/{fiksOrgId}/status": {
      "get": {
        "tags": [
          "KonfigurasjonStatus"
        ],
        "summary": "Hent status for konfigurasjonen av Fiks konsesjon",
        "description": "Sjekker hvert steg kommunen må ha på plass for å ta i bruk Fiks konsesjon, jf. veilederen. Kommunen kan ta i bruk tjenesten når alle stegene er ok. Statusen hentes ferskt ved hvert kall.",
        "operationId": "hentKonfigurasjonStatus",
        "parameters": [
          {
            "in": "path",
            "name": "fiksOrgId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/FiksOrgId"
            },
            "description": "Fiks organisasjons-ID for kommunen"
          }
        ],
        "responses": {
          "200": {
            "description": "Status for konfigurasjonen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KonfigurasjonStatus"
                }
              }
            }
          },
          "401": {
            "description": "Ikke tilgang – bearer token ikke sendt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "502": {
            "description": "Fiks konfigurasjon eller Fiks protokoll er utilgjengelig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FiksOrgId": {
        "type": "string",
        "format": "uuid",
        "description": "Fiks organisasjons-ID (UUID)"
      },
      "ArkivKontoId": {
        "type": "string",
        "format": "uuid",
        "description": "Unik ID for en Fiks Arkiv-konto (UUID)"
      },
      "ArkivKontoSammendrag": {
        "type": "object",
        "description": "Sammendrag av en Fiks Arkiv-konto, til bruk ved valg av konto",
        "required": [
          "kontoId",
          "navn"
        ],
        "properties": {
          "kontoId": {
            "$ref": "#/components/schemas/ArkivKontoId"
          },
          "navn": {
            "type": "string",
            "description": "Visningsnavn for kontoen"
          },
          "beskrivelse": {
            "type": "string",
            "description": "Valgfri beskrivelse av kontoen"
          },
          "fiksOrgId": {
            "$ref": "#/components/schemas/FiksOrgId"
          }
        }
      },
      "ArkivKontoMedStatus": {
        "type": "object",
        "description": "Konfigurert Fiks Arkiv-konto med køstatus og konsumenter",
        "required": [
          "kontoId",
          "navn"
        ],
        "properties": {
          "kontoId": {
            "$ref": "#/components/schemas/ArkivKontoId"
          },
          "navn": {
            "type": "string",
            "description": "Visningsnavn for kontoen"
          },
          "beskrivelse": {
            "type": "string",
            "description": "Valgfri beskrivelse av kontoen"
          },
          "fiksOrgId": {
            "$ref": "#/components/schemas/FiksOrgId"
          },
          "antallMeldingerPaaKoe": {
            "type": "integer",
            "format": "int64",
            "description": "Antall meldinger som venter i køen for denne kontoen"
          },
          "antallKonsumenter": {
            "type": "integer",
            "format": "int32",
            "description": "Antall aktive konsumenter som lytter på køen"
          }
        }
      },
      "SettArkivKontoRequest": {
        "type": "object",
        "description": "Forespørsel om å sette ny Fiks Arkiv-konto for konsesjon",
        "required": [
          "kontoId"
        ],
        "properties": {
          "kontoId": {
            "$ref": "#/components/schemas/ArkivKontoId"
          }
        }
      },
      "KonfigurasjonSteg": {
        "type": "string",
        "description": "Et steg i konfigurasjonen av Fiks konsesjon. Tjenestestegene gjelder aktivering i Fiks forvaltning. FIKS_REGISTER_ROLLE gjelder konsesjonsrollen i Fiks register, som opprettes ved konfigurasjon av folkeregister.",
        "enum": [
          "FIKS_KONSESJON",
          "MINKOMMUNE_OPPGAVE",
          "MINKOMMUNE_INNSYN",
          "FIKS_REGISTER",
          "FIKS_PROTOKOLL",
          "FIKS_REGISTER_ROLLE",
          "ARKIVKONTO_VALGT",
          "ARKIVKONTO_KAN_MOTTA"
        ]
      },
      "KonfigurasjonStegStatus": {
        "type": "object",
        "description": "Status for ett steg i konfigurasjonen",
        "required": [
          "steg",
          "ok"
        ],
        "properties": {
          "steg": {
            "$ref": "#/components/schemas/KonfigurasjonSteg"
          },
          "ok": {
            "type": "boolean",
            "description": "Om steget er på plass"
          },
          "melding": {
            "type": "string",
            "description": "Hva som mangler, når steget ikke er ok"
          }
        }
      },
      "KonfigurasjonStatus": {
        "type": "object",
        "description": "Status for kommunens konfigurasjon av Fiks konsesjon",
        "required": [
          "klar",
          "steg"
        ],
        "properties": {
          "klar": {
            "type": "boolean",
            "description": "Om alle stegene er på plass, slik at kommunen kan ta i bruk Fiks konsesjon"
          },
          "steg": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KonfigurasjonStegStatus"
            }
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Fiks: Mine Kommuner Service",
    "description": "Mine kommuner service",
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks-utvikling@ks.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.test.ks.no",
      "description": "KS Fiks API host"
    }
  ],
  "tags": [
    {
      "name": "mine-kommuner",
      "description": "API for henting av kommuner og fylkeskommuner som en bruker har en tilknytning til"
    }
  ],
  "paths": {
    "/mine-kommuner/api/v1/kommuner": {
      "get": {
        "tags": [
          "mine-kommuner"
        ],
        "description": "Henter en liste av kommuner og fylkeskommuner innlogget bruker har en tilknytning til. Fiks organisasjons id til fylkeskommunene er funnet ved å søke opp fylkeskommunenummer som er koblet mot kommunene som er funnet.",
        "operationId": "getMineKommuner",
        "parameters": [
          {
            "name": "OnBehalfOf",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste med organisasjoner som autentisert bruker har tilknytning til",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TilknyttetKommuneList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Organisasjon": {
        "required": [
          "id",
          "navn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Organisasjonens id",
            "format": "uuid"
          },
          "navn": {
            "type": "string",
            "description": "Organisasjonens navn"
          }
        },
        "description": "Informasjon om en organisasjon"
      },
      "TilknyttetFylkeskommune": {
        "required": [
          "fiksOrganisasjonId",
          "fylkeskommune",
          "tilknytninger"
        ],
        "type": "object",
        "properties": {
          "fiksOrganisasjonId": {
            "type": "string",
            "description": "Fiks organisasjonens id",
            "format": "uuid"
          },
          "fylkeskommune": {
            "$ref": "#/components/schemas/Organisasjon"
          },
          "tilknytninger": {
            "type": "array",
            "description": "En eller flere begrunnelser for at denne organisasjonen er tilknyttet brukeren",
            "items": {
              "type": "string",
              "description": "En eller flere begrunnelser for at denne organisasjonen er tilknyttet brukeren",
              "enum": [
                "TREFF_I_INNSYN"
              ]
            }
          }
        },
        "description": "Informasjon om en fylkeskommune som er tilknyttet en bruker, samt begrunnelse for tilknytningen"
      },
      "TilknyttetKommune": {
        "required": [
          "fiksOrganisasjonId",
          "kommune",
          "tilknytninger"
        ],
        "type": "object",
        "properties": {
          "fiksOrganisasjonId": {
            "type": "string",
            "description": "Fiks organisasjonens id",
            "format": "uuid"
          },
          "kommune": {
            "$ref": "#/components/schemas/Organisasjon"
          },
          "fylkeskommune": {
            "$ref": "#/components/schemas/Organisasjon"
          },
          "tilknytninger": {
            "type": "array",
            "description": "En eller flere begrunnelser for at denne organisasjonen er tilknyttet brukeren",
            "items": {
              "type": "string",
              "description": "En eller flere begrunnelser for at denne organisasjonen er tilknyttet brukeren",
              "enum": [
                "TREFF_I_INNSYN"
              ]
            }
          },
          "fylkeskommuneFiksOrgId": {
            "type": "string",
            "description": "Fiks organisasjonens id til fylkeskommunen som er tilknyttet kommunen",
            "format": "uuid"
          }
        },
        "description": "Informasjon om en kommune som er tilknyttet en bruker, samt begrunnelse for tilknytningen"
      },
      "TilknyttetKommuneList": {
        "required": [
          "fylkeskommuner",
          "kommuner"
        ],
        "type": "object",
        "properties": {
          "kommuner": {
            "type": "array",
            "description": "En liste av kommuner tilknyttet en bruker",
            "items": {
              "$ref": "#/components/schemas/TilknyttetKommune"
            }
          },
          "fylkeskommuner": {
            "type": "array",
            "description": "En liste av fylkeskommuner tilknyttet en bruker",
            "items": {
              "$ref": "#/components/schemas/TilknyttetFylkeskommune"
            }
          }
        },
        "description": "En liste av kommuner og fylkeskommuner tilknyttet en bruker"
      }
    }
  }
}
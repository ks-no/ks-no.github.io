{
  "openapi": "3.0.1",
  "info": {
    "title": "KS SvarUt: Mottakersystem-API",
    "description": "API henting av mottakersystem",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ksdigital.no"
    },
    "version": "v2"
  },
  "servers": [
    {
      "url": "https://test.svarut.ks.no/api",
      "description": "SvarUt testmiljø"
    },
    {
      "url": "https://svarut.ks.no/api",
      "description": "SvarUt produksjonsmiljø"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Mottakersystem",
      "description": "API henting av mottakersystem"
    }
  ],
  "paths": {
    "/v2/mottakersystem": {
      "get": {
        "tags": [
          "Mottakersystem"
        ],
        "summary": "Hent mottakersystem",
        "description": "Henter mottakersystem tilknyttet et orgnummer",
        "operationId": "hentMottakersystem",
        "parameters": [
          {
            "name": "organisasjonsnummer",
            "in": "query",
            "schema": {
              "pattern": "^[0-9]{9}$",
              "type": "string"
            }
          },
          {
            "name": "forsendelseType",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-zA-ZæøåÆØÅ0-9]+(\\.[a-zA-ZæøåÆØÅ0-9]+)*$",
              "type": "string"
            }
          },
          {
            "name": "niva",
            "in": "query",
            "schema": {
              "maximum": 9,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mottakersystem knyttet til orgnummer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mottakersystemer"
                }
              }
            }
          },
          "default": {
            "description": "Feil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Mottakersystem": {
        "required": [
          "forsendelseType",
          "id",
          "navn",
          "niva",
          "organisasjonsnummer"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Mottakersystemets id"
          },
          "navn": {
            "type": "string",
            "description": "Navn på mottakersystem"
          },
          "organisasjonsnummer": {
            "type": "string",
            "description": "Organisasjonsnummer for denne registreringen"
          },
          "forsendelseType": {
            "type": "string",
            "description": "Forsendelsestype for denne registreringen"
          },
          "niva": {
            "type": "integer",
            "description": "Sikkerhetsnivå for denne registreringen",
            "format": "int32"
          }
        },
        "description": "Liste med mottakersystemer"
      },
      "Mottakersystemer": {
        "required": [
          "mottakersystemer"
        ],
        "type": "object",
        "properties": {
          "mottakersystemer": {
            "type": "array",
            "description": "Liste med mottakersystemer",
            "items": {
              "$ref": "#/components/schemas/Mottakersystem"
            }
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
{
  "openapi": "3.0.1",
  "info": {
    "title": "KS SvarUt: Mottaker API",
    "description": "API for å hente forsendelse informasjon som mottaker",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ksdigital.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://test.svarut.ks.no/api",
      "description": "SvarUt testmiljø"
    },
    {
      "url": "https://svarut.ks.no/api",
      "description": "SvarUt produksjonsmiljø"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "MottakerV1",
      "description": "API for å hente forsendelse informasjon som mottaker"
    }
  ],
  "paths": {
    "/v1/mottaker/forsendelser/{forsendelseId}/svar-metadata": {
      "get": {
        "tags": [
          "MottakerV1"
        ],
        "summary": "Hent svar metadata for forsendelse",
        "description": "Henter svar metadata om forsendelsen",
        "operationId": "hentForsendelseInfo",
        "parameters": [
          {
            "name": "forsendelseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Svar metadata for forsendelse",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForsendelseMottakerDataResponse"
                }
              }
            }
          },
          "403": {
            "description": "Innlogget bruker er ikke mottaker av forsendelsen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "default": {
            "description": "Feil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Adresse": {
        "required": [
          "adresse1",
          "navn",
          "poststed"
        ],
        "type": "object",
        "properties": {
          "orgnr": {
            "type": "string",
            "description": "Organisasjonsnummeret adresen tilhører. Dersom denne er satt er ikke fnr satt."
          },
          "fnr": {
            "type": "string",
            "description": "Fødselsnummeret adressen tilhører. Dersom denne er satt er ikke orgnr satt."
          },
          "navn": {
            "type": "string",
            "description": "Navn på person eller organisasjon"
          },
          "adresse1": {
            "type": "string",
            "description": "Første adresselinje"
          },
          "adresse2": {
            "type": "string",
            "description": "Andre adresselinje"
          },
          "adresse3": {
            "type": "string",
            "description": "Tredje adresselinje"
          },
          "postnr": {
            "type": "string",
            "description": "Postnummer. Alltid satt for norske adresser."
          },
          "poststed": {
            "type": "string",
            "description": "Poststed. Satt for alle adresser."
          },
          "land": {
            "type": "string",
            "description": "Land. Ingen verdi betyr Norge."
          }
        },
        "description": "'Svar sendes til' på forsendelsen"
      },
      "AvsenderKonto": {
        "required": [
          "aktiv",
          "fiksOrganisasjonId",
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id for avsenderkonto",
            "format": "uuid"
          },
          "fiksOrganisasjonId": {
            "type": "string",
            "description": "Id for Fiks organisasjon som eier avsenderen",
            "format": "uuid"
          },
          "aktiv": {
            "type": "boolean",
            "description": "Indikerer om avsenderkontoen er aktiv"
          }
        },
        "description": "Informasjon om kontoen benyttet til å sende forsendelsen"
      },
      "ForsendelseMottakerDataResponse": {
        "required": [
          "avsenderKonto",
          "forsendelseId",
          "kanSvarePaaForsendelse",
          "mottaker",
          "tittel"
        ],
        "type": "object",
        "properties": {
          "avsenderKonto": {
            "$ref": "#/components/schemas/AvsenderKonto"
          },
          "forsendelseId": {
            "type": "string",
            "description": "Forsendelsens id"
          },
          "tittel": {
            "type": "string",
            "description": "Tittel på forsendelse"
          },
          "mottaker": {
            "$ref": "#/components/schemas/Adresse"
          },
          "svarSendesTil": {
            "$ref": "#/components/schemas/Adresse"
          },
          "kanSvarePaaForsendelse": {
            "type": "boolean",
            "description": "Indikerer om forsendelsen kan svares på eller ikke"
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
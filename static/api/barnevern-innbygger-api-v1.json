{
  "openapi": "3.0.3",
  "info": {
    "title": "KS FIKS: Barnevern Innbygger Service",
    "description": "Barnevern Innbygger Service",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://www.ks.no/fagomrader/digitalisering/utviklingsprosjekter",
      "email": "fiks-utvikling@ks.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://min.kommune.no",
      "description": "KS Min Kommune host"
    },
    {
      "url": "https://min.fiks.test.ks.no",
      "description": "KS Min Kommune test host"
    },
    {
      "url": "https://min.fiks.dev.ks.no",
      "description": "KS Min Kommune dev host"
    }
  ],
  "tags": [
    {
      "name": "barnevern-innbygger",
      "description": "API for barnevern i Min Kommune"
    }
  ],
  "paths": {
    "/minkommune-barnevern-innbygger/api/v1/edialog": {
      "post": {
        "tags": [
          "Barnevern-innbygger"
        ],
        "description": "Oppretter eller henter eDialog-skjema tilknyttet gitt `dokumentId` og `edialogType`. Hvis `edialogType` er `POST`, er dokumentet en mappe, og en journalpost for `SVAR`. Dersom et skjema allerede finnes, returneres det med responskode 200. Ellers opprettes et skjema, og det returneres med responskode 201.",
        "summary": "Opprett nytt eller hent eksisterende eDialog-skjema",
        "operationId": "opprettEdialogskjema",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpprettEdialogSkjemaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Skjema hentet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpprettEdialogSkjemaResponse"
                }
              }
            }
          },
          "201": {
            "description": "Skjema opprettet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpprettEdialogSkjemaResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Kunne ikke finne tilknytning for barnevernskontor og skjematype, eller kunne ikke finne mappe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/minkommune-barnevern-innbygger/api/v1/edialog/{skjemaId}": {
      "put": {
        "tags": [
          "Barnevern-innbygger"
        ],
        "description": "Oppdater eksisterende eDialog-skjema med gitt `skjemaId` for gitt `dokumentId` og `edialogType`. Oppdatering skjer ved at meldingsinnholdet blir erstattet med `melding`.",
        "summary": "Oppdater edialog-skjema",
        "operationId": "oppdaterEdialogskjema",
        "parameters": [
          {
            "in": "path",
            "name": "skjemaId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OppdaterEdialogSkjemaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Oppdatert skjema"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Kunne ikke finne mappe med gitt dokumentId eller skjema med gitt skjemaId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/AlleredeInnsendt"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/minkommune-barnevern-innbygger/api/v1/edialog/{skjemaId}/send": {
      "post": {
        "tags": [
          "Barnevern-innbygger"
        ],
        "description": "Send inn edialog-skjema med nåværende innhold. Skjemaet kan ikke endres eller hentes fram igjen med /edialog/{skjemaId} etter at det er sendt. Merk at dersom man forsøker å sende inn samme skjema flere ganger, vil man få en 201-respons, men skjemaet vil ikke bli sendt inn på nytt. Dette skiller seg fra måten oppdatering fungerer, og skyldes oppførsel fra eDialog selv.",
        "summary": "Send edialog-skjema",
        "operationId": "sendEdialogSkjema",
        "parameters": [
          {
            "in": "path",
            "name": "skjemaId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Sendt skjema"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Kunne ikke finne skjema med gitt skjemaId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Ugyldig forespørsel",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "AlleredeInnsendt": {
        "description": "Skjema er allerede sendt",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Ingen tilgang",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Systemfeil",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      }
    },
    "schemas": {
      "EdialogType": {
        "type": "string",
        "description": "Type av edialog",
        "enum": [
          "POST",
          "SVAR"
        ]
      },
      "OpprettEdialogSkjemaRequest": {
        "type": "object",
        "required": [
          "edialogType",
          "dokumentId"
        ],
        "properties": {
          "edialogType": {
            "$ref": "#/components/schemas/EdialogType"
          },
          "dokumentId": {
            "type": "string",
            "description": "ID til dokumentet som skjema opprettes for. Dersom edialogType er `POST`, er dokumentet en mappe, og en journalpost når edialogType er `SVAR`. Består av 3 UUID'er.",
            "example": "b90e4efd-d8d7-4d16-a721-a9eaf50bf9bd_c1ca71e4-0acc-4145-906c-5677a5ed0fc3_8aea2c2d-a269-4d28-8cb6-66b05e4d032b"
          }
        },
        "description": "Request-objekt for å søke etter mottaker med organisasjonsnummer eller fødselsnummer. Må ha med enten organisasjonsnummer eller fødselsnummer. Bør ha med mottakerId for eksisterende mottaker for å hindre at DUPLIKAT-sjekken slår inn"
      },
      "OpprettEdialogSkjemaResponse": {
        "type": "object",
        "required": [
          "skjemaId"
        ],
        "properties": {
          "skjemaId": {
            "type": "string",
            "format": "uuid"
          },
          "melding": {
            "type": "string"
          }
        }
      },
      "OppdaterEdialogSkjemaRequest": {
        "type": "object",
        "required": [
          "dokumentId",
          "edialogType",
          "melding"
        ],
        "properties": {
          "dokumentId": {
            "type": "string"
          },
          "melding": {
            "type": "string",
            "maxLength": 10000
          },
          "edialogType": {
            "$ref": "#/components/schemas/EdialogType"
          }
        },
        "description": "Request-objekt for å oppdatere et eksisterende eDialog-skjema tilknyttet et barnevernskontor."
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "errorId": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string"
          },
          "originalPath": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "errorJson": {
            "type": "string"
          }
        }
      }
    }
  }
}
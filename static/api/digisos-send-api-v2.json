{
  "openapi": "3.0.1",
  "info": {
    "title": "Fiks Digisos Send API v2",
    "description": "API v2 for innsending av søknad og ettersendelse.",
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://developers.fiks.ks.no",
      "email": "fiks@ksdigital.no"
    },
    "version": "v2"
  },
  "tags": [
    {
      "name": "Søknad og ettersendelse v2",
      "description": "Endepunkter for innsending av søknad og ettersendelse (versjon 2)"
    }
  ],
  "paths": {
    "/digisos/api/v2/soknader/{kommunenummer}/{soknadId}/{navEksternRefId}": {
      "post": {
        "tags": [
          "Søknad og ettersendelse v2"
        ],
        "summary": "Ettersend informasjon (v2)",
        "description": "Ettersender dokumentasjon/vedlegg til en eksisterende søknad.",
        "operationId": "ettersendInfo",
        "parameters": [
          {
            "name": "kommunenummer",
            "in": "path",
            "description": "Kommunenummer (4 siffer)",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}$",
              "type": "string"
            },
            "example": "0301"
          },
          {
            "name": "soknadId",
            "in": "path",
            "description": "Digisos-ID til eksisterende søknad",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6"
          },
          {
            "name": "navEksternRefId",
            "in": "path",
            "description": "Ekstern referanse-ID fra NAV (maks 60 tegn). Tillatte tegn: bokstaver, tall, underscore og bindestrek",
            "required": true,
            "schema": {
              "maxLength": 60,
              "minLength": 0,
              "pattern": "^[0-9a-zA-Z_\\-]*",
              "type": "string"
            },
            "example": "ref-123_ABC"
          }
        ],
        "responses": {
          "202": {
            "description": "Ettersendelse akseptert",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "400": {
            "description": "Ugyldig input",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "401": {
            "description": "Uautorisert",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "403": {
            "description": "Ingen tilgang",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "404": {
            "description": "Søknad finnes ikke",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "415": {
            "description": "Ustøttet media type",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "500": {
            "description": "Uventet feil",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          }
        }
      }
    },
    "/digisos/api/v2/soknader/{kommunenummer}/{navEksternRefId}": {
      "post": {
        "tags": [
          "Søknad og ettersendelse v2"
        ],
        "summary": "Send inn søknad (v2)",
        "description": "Sender inn en søknad med tilhørende data. Returnerer tildelt Digisos-ID dersom innsending aksepteres.",
        "operationId": "sendSoknad",
        "parameters": [
          {
            "name": "kommunenummer",
            "in": "path",
            "description": "Kommunenummer (4 siffer)",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}$",
              "type": "string"
            },
            "example": "0301"
          },
          {
            "name": "navEksternRefId",
            "in": "path",
            "description": "Ekstern referanse-ID fra NAV (maks 60 tegn). Tillatte tegn: bokstaver, tall, underscore og bindestrek",
            "required": true,
            "schema": {
              "maxLength": 60,
              "minLength": 0,
              "pattern": "^[0-9a-zA-Z_\\-]*",
              "type": "string"
            },
            "example": "ref-123_ABC"
          }
        ],
        "responses": {
          "202": {
            "description": "Innsending akseptert",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "description": "Ugyldig input",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "401": {
            "description": "Uautorisert",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "403": {
            "description": "Ingen tilgang",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "415": {
            "description": "Ustøttet media type",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          },
          "500": {
            "description": "Uventet feil",
            "content": {
              "application/json": {},
              "text/plain": {}
            }
          }
        }
      }
    }
  },
  "components": {}
}
        "type" : "object",
        "properties" : {
          "id" : {
            "minLength" : 1,
            "type" : "string",
            "description" : "Id på konto og tilhørende Fiks IO-konto",
            "format" : "uuid"
          },
          "navn" : {
            "minLength" : 1,
            "type" : "string",
            "description" : "Navn på konto"
          },
          "stottetProtokollNavn" : {
            "minLength" : 1,

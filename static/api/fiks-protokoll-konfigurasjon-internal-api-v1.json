{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "KS Fiks: Protokoll",
    "description" : "Fiks Protokoll service. Endepunkt som brukes internt på Fiks Plattformen",
    "contact" : {
      "name" : "Fiks-brukerstøtte",
      "url" : "https://ks-no.github.io/",
      "email" : "fiks-utvikling@ks.no"
    },
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "https://api.fiks.ks.no",
    "description" : "KS Fiks API host"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "Protokoll-konfigurasjon-internal",
    "description" : "API for konfigurering av Fiks Protokoll"
  } ],
  "paths" : {
    "/fiks-protokoll/api/v1/konfigurasjon/protokollSystemInfo" : {
      "get" : {
        "tags" : [ "Protokoll-konfigurasjon-internal" ],
        "description" : "Henter systemInfo for system/integrasjon/konto/kommune/fiksOrgId",
        "operationId" : "getProtokollSystemInfo",
        "parameters" : [ {
          "name" : "type",
          "in" : "query",
          "schema" : {
            "type" : "string",
            "enum" : [ "SYSTEMID", "INTEGRASJONID", "FIKSORGID", "FIKSIOKONTOID", "KOMMUNENUMMER" ]
          }
        }, {
          "name" : "id",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Henter alle protokoller",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ProtokollSystemResponse"
                  }
                }
              }
            }
          },
          "default" : {
            "description" : "Noe gikk galt",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/fiks-protokoll/api/v1/konfigurasjon/valider" : {
      "post" : {
        "tags" : [ "Protokoll-konfigurasjon-internal" ],
        "description" : "Validerer at forsendelse er gyldig i følge Fiks Protokoll-regler",
        "operationId" : "validerForsendelse",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ValiderForsendelseRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Sjekker at melding kan sendes fra en konto til en annen"
          },
          "default" : {
            "description" : "Noe gikk galt",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {

{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Fiks: Fiks IO Meldingssporing",
    "description": "API for sporing av meldinger sendt via Fiks IO",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ksdigital.no/om-oss/kontakt-oss/",
      "email": "fiks@ksdigital.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.test.ks.no",
      "description": "API-tjener for KS Fiks"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Meldingssporing",
      "description": "Meldingsinformasjon og dialoger for meldinger sendt via Fiks IO"
    }
  ],
  "paths": {
    "/fiks-io/meldingssporing/api/v1/root/meldinger/{meldingId}/dialog": {
      "parameters": [
        {
          "$ref": "#/components/parameters/MeldingIdPath"
        }
      ],
      "get": {
        "tags": [
          "Meldingssporing"
        ],
        "description": "Hent dialogen som inneholder meldingen, med ROOT-tilgang.",
        "operationId": "hentRootDialogForMelding",
        "responses": {
          "200": {
            "description": "Dialogen med alle registrerte meldinger",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogMedMeldinger"
                }
              }
            }
          },
          "403": {
            "description": "Mangler admin tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Fant ikke meldingen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/fiks-io/meldingssporing/api/v1/fiksorg/{fiksOrgId}/system/{systemId}/meldinger/{meldingId}/dialog": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FiksOrgIdPath"
        },
        {
          "$ref": "#/components/parameters/SystemIdPath"
        },
        {
          "$ref": "#/components/parameters/MeldingIdPath"
        }
      ],
      "get": {
        "tags": [
          "Meldingssporing"
        ],
        "description": "Hent dialogen som inneholder meldingen for oppgitt FiksOrg og system.",
        "operationId": "hentFiksOrgSystemDialogForMelding",
        "responses": {
          "200": {
            "description": "Dialogen med alle registrerte meldinger",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogMedMeldinger"
                }
              }
            }
          },
          "403": {
            "description": "Mangler admin tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Fant ikke meldingen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/fiks-io/meldingssporing/api/v1/fiksorg/{fiksOrgId}/system/{systemId}/konto/{kontoId}/meldinger/{meldingId}/dialog": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FiksOrgIdPath"
        },
        {
          "$ref": "#/components/parameters/SystemIdPath"
        },
        {
          "$ref": "#/components/parameters/KontoIdPath"
        },
        {
          "$ref": "#/components/parameters/MeldingIdPath"
        }
      ],
      "get": {
        "tags": [
          "Meldingssporing"
        ],
        "description": "Hent dialogen som inneholder meldingen for oppgitt FiksOrg, system og konto.",
        "operationId": "hentFiksOrgSystemKontoDialogForMelding",
        "responses": {
          "200": {
            "description": "Dialogen med alle registrerte meldinger",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogMedMeldinger"
                }
              }
            }
          },
          "403": {
            "description": "Mangler admin tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Fant ikke meldingen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/fiks-io/meldingssporing/api/v1/root/dialoger": {
      "get": {
        "tags": [
          "Meldingssporing"
        ],
        "description": "Søk etter dialoger med ROOT-tilgang. En dialog tas med dersom minst én melding oppfyller filtrene.",
        "operationId": "sokRootDialoger",
        "parameters": [
          {
            "$ref": "#/components/parameters/AvsenderKontoId"
          },
          {
            "$ref": "#/components/parameters/MottakerKontoId"
          },
          {
            "$ref": "#/components/parameters/AvsenderSystemId"
          },
          {
            "$ref": "#/components/parameters/MottakerSystemId"
          },
          {
            "$ref": "#/components/parameters/MeldingType"
          },
          {
            "$ref": "#/components/parameters/ErFeilmelding"
          },
          {
            "$ref": "#/components/parameters/KlientMeldingId"
          },
          {
            "$ref": "#/components/parameters/KlientKorrelasjonsId"
          },
          {
            "$ref": "#/components/parameters/HarAvvik"
          },
          {
            "$ref": "#/components/parameters/RabbitAarsak"
          },
          {
            "$ref": "#/components/parameters/Fra"
          },
          {
            "$ref": "#/components/parameters/Til"
          },
          {
            "$ref": "#/components/parameters/Side"
          },
          {
            "$ref": "#/components/parameters/Antall"
          }
        ],
        "responses": {
          "200": {
            "description": "Dialoger som samsvarer med søket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogSokResultat"
                }
              }
            }
          },
          "400": {
            "description": "Ugyldig forespørsel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Mangler admin tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/fiks-io/meldingssporing/api/v1/fiksorg/{fiksOrgId}/system/{systemId}/dialoger": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FiksOrgIdPath"
        },
        {
          "$ref": "#/components/parameters/SystemIdPath"
        }
      ],
      "get": {
        "tags": [
          "Meldingssporing"
        ],
        "description": "Søk etter dialoger for oppgitt FiksOrg og system. En dialog tas med dersom minst én melding oppfyller filtrene.",
        "operationId": "sokFiksOrgSystemDialoger",
        "parameters": [
          {
            "$ref": "#/components/parameters/AvsenderKontoId"
          },
          {
            "$ref": "#/components/parameters/MottakerKontoId"
          },
          {
            "$ref": "#/components/parameters/AvsenderSystemId"
          },
          {
            "$ref": "#/components/parameters/MottakerSystemId"
          },
          {
            "$ref": "#/components/parameters/MeldingType"
          },
          {
            "$ref": "#/components/parameters/ErFeilmelding"
          },
          {
            "$ref": "#/components/parameters/KlientMeldingId"
          },
          {
            "$ref": "#/components/parameters/KlientKorrelasjonsId"
          },
          {
            "$ref": "#/components/parameters/HarAvvik"
          },
          {
            "$ref": "#/components/parameters/RabbitAarsak"
          },
          {
            "$ref": "#/components/parameters/Fra"
          },
          {
            "$ref": "#/components/parameters/Til"
          },
          {
            "$ref": "#/components/parameters/Side"
          },
          {
            "$ref": "#/components/parameters/Antall"
          }
        ],
        "responses": {
          "200": {
            "description": "Dialoger som samsvarer med søket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogSokResultat"
                }
              }
            }
          },
          "400": {
            "description": "Ugyldig forespørsel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Mangler admin tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/fiks-io/meldingssporing/api/v1/fiksorg/{fiksOrgId}/system/{systemId}/konto/{kontoId}/dialoger": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FiksOrgIdPath"
        },
        {
          "$ref": "#/components/parameters/SystemIdPath"
        },
        {
          "$ref": "#/components/parameters/KontoIdPath"
        }
      ],
      "get": {
        "tags": [
          "Meldingssporing"
        ],
        "description": "Søk etter dialoger for oppgitt FiksOrg, system og konto. En dialog tas med dersom minst én melding oppfyller filtrene.",
        "operationId": "sokFiksOrgSystemKontoDialoger",
        "parameters": [
          {
            "$ref": "#/components/parameters/AvsenderKontoId"
          },
          {
            "$ref": "#/components/parameters/MottakerKontoId"
          },
          {
            "$ref": "#/components/parameters/AvsenderSystemId"

  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "FiksOrgIdPath": {
        "name": "fiksOrgId",
        "in": "path",
        "required": true,
        "description": "ID-en til FiksOrg som forespørselen gjelder.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SystemIdPath": {
        "name": "systemId",
        "in": "path",
        "required": true,
        "description": "ID-en til systemet som forespørselen gjelder.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "KontoIdPath": {
        "name": "kontoId",
        "in": "path",
        "required": true,
        "description": "ID-en til kontoen som forespørselen gjelder.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "MeldingIdPath": {
        "name": "meldingId",
        "in": "path",
        "required": true,
        "description": "ID-en til en melding i dialogen.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AvsenderKontoId": {
        "name": "avsenderKontoId",
        "in": "query",
        "description": "Filtrer på avsenderkonto. En dialog tas med dersom minst én melding oppfyller filteret.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "MottakerKontoId": {
        "name": "mottakerKontoId",
        "in": "query",
        "description": "Filtrer på mottakerkonto. En dialog tas med dersom minst én melding oppfyller filteret.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AvsenderSystemId": {
        "name": "avsenderSystemId",
        "in": "query",
        "description": "Filtrer på avsenders system-ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "MottakerSystemId": {
        "name": "mottakerSystemId",
        "in": "query",
        "description": "Filtrer på mottakers system-ID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "MeldingType": {
        "name": "meldingType",
        "in": "query",
        "description": "Filtrer på meldingstype. Oppgi meldingstypens fullstendige navn.",
        "schema": {
          "type": "string"
        }
      },
      "ErFeilmelding": {
        "name": "erFeilmelding",
        "in": "query",
        "description": "Filtrer på om meldingen er en feilmelding. En dialog tas med dersom minst én melding oppfyller filteret.",
        "schema": {
          "type": "boolean"
        }
      },
      "KlientMeldingId": {
        "name": "klientMeldingId",
        "in": "query",
        "description": "Filtrer på ID-en avsenderen har gitt meldingen.",
        "schema": {
          "type": "string"
        }
      },
      "KlientKorrelasjonsId": {
        "name": "klientKorrelasjonsId",
        "in": "query",
        "description": "Filtrer på avsenderens korrelasjons-ID.",
        "schema": {
          "type": "string"
        }
      },
      "HarAvvik": {
        "name": "harAvvik",
        "in": "query",
        "description": "Filtrer på transportavvik. En dialog tas med dersom minst én melding har et avvik.",
        "schema": {
          "type": "boolean"
        }
      },
      "RabbitAarsak": {
        "name": "rabbitAarsak",
        "in": "query",
        "description": "Filtrer på årsaken til RabbitMQ-avviket.",
        "schema": {
          "type": "string",
          "enum": [
            "expired",
            "delivery_limit",
            "rejected",
            "maxlen",
            "ukjent"
          ]
        }
      },
      "Fra": {
        "name": "fra",
        "in": "query",
        "description": "Ta med meldinger sendt etter dette tidspunktet. En dialog tas med dersom minst én melding oppfyller filteret.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "Til": {
        "name": "til",
        "in": "query",
        "description": "Ta med meldinger sendt før dette tidspunktet. En dialog tas med dersom minst én melding oppfyller filteret.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "Side": {
        "name": "side",
        "in": "query",
        "description": "Sidenummer. Første side er 0.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "Antall": {
        "name": "antall",
        "in": "query",
        "description": "Antall dialoger per side (1–100).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "schemas": {
      "Meldingsinfo": {
        "type": "object",
        "description": "Metadata om meldingen. Meldingsinnholdet lagres ikke i meldingssporingen.",
        "required": [
          "meldingId",
          "meldingType",
          "startMeldingId",
          "systemkvittering",
          "avsender",
          "mottaker",
          "harPayload",
          "sendt",
          "status",
          "slettes"
        ],
        "properties": {
          "meldingId": {
            "type": "string",
            "format": "uuid"
          },
          "meldingType": {
            "type": "string",
            "description": "Meldingstypens fullstendige navn."
          },
          "startMeldingId": {
            "type": "string",
            "format": "uuid",
            "description": "ID-en til startmeldingen i dialogen. Meldingen kan være slettet fra sporingen."
          },
          "svarPaMeldingId": {
            "type": "string",
            "format": "uuid"
          },
          "svarPaMeldingType": {
            "type": "string"
          },
          "erFeilmelding": {
            "type": "boolean"
          },
          "systemkvittering": {
            "type": "boolean",
            "description": "Angir om Fiks IO har generert meldingen som en systemkvittering."
          },
          "avsender": {
            "$ref": "#/components/schemas/Deltaker"
          },
          "mottaker": {
            "$ref": "#/components/schemas/Deltaker"
          },
          "klientMeldingId": {
            "type": "string"
          },
          "klientKorrelasjonsId": {
            "type": "string"
          },
          "harPayload": {
            "type": "boolean"
          },
          "sendt": {
            "type": "string",
            "format": "date-time"
          },
          "utloper": {
            "type": "string",
            "format": "date-time"
          },
          "publisert": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/Meldingsstatus"
          },
          "avvik": {
            "$ref": "#/components/schemas/Avvik"
          },
          "slettes": {
            "type": "string",
            "format": "date-time",
            "description": "Tidspunktet da sporingsdataene for meldingen slettes."
          }
        }
      },
      "Deltaker": {
        "type": "object",
        "required": [
          "kontoId"
        ],
        "properties": {
          "kontoId": {
            "type": "string",
            "format": "uuid"
          },
          "systemId": {
            "type": "string",
            "format": "uuid",
            "description": "Deltakerens system-ID, hvis den er kjent."
          }
        }
      },
      "Avvik": {
        "type": "object",
        "description": "Transportavvik knyttet til meldingen på mottakerens kø.",
        "required": [
          "tidspunkt",
          "rabbitAarsak"
        ],
        "properties": {
          "tidspunkt": {
            "type": "string",
            "format": "date-time"
          },
          "rabbitAarsak": {
            "type": "string",
            "description": "Årsaken RabbitMQ oppga for avviket (x-first-death-reason).",
            "enum": [
              "expired",
              "delivery_limit",
              "rejected",
              "maxlen",
              "ukjent"
            ]
          },
          "systemkvitteringMeldingId": {
            "type": "string",
            "format": "uuid",
            "description": "ID-en til systemkvitteringen Fiks IO eventuelt sendte til avsender."
          },
          "systemkvitteringType": {
            "type": "string"
          }
        }
      },
      "Meldingsstatus": {
        "type": "string",
        "description": "PUBLISERT betyr at meldingen er lagt på mottakerens kø, ikke at den er lest. Status beregnes fra avviket.",
        "enum": [
          "PUBLISERT",
          "TIDSAVBRUDD",
          "LEVERINGSFEIL",
          "AVVIST",
          "UKJENT_AVVIK"
        ]
      },
      "Dialog": {
        "type": "object",
        "description": "Sammendrag av meldingene i dialogen.",
        "required": [
          "meldingId",
          "harAvvik",
          "harFeilmelding",
          "meldingTyper",
          "startMeldingMangler",
          "startet",
          "sisteMeldingSendt",
          "antallMeldinger"
        ],
        "properties": {
          "meldingId": {
            "type": "string",
            "format": "uuid",
            "description": "ID-en til en melding i dialogen. Bruk denne ID-en for å hente dialogen."
          },
          "startMeldingMangler": {
            "type": "boolean",
            "description": "Angir om startmeldingen mangler i sporingen."
          },
          "harAvvik": {
            "type": "boolean",
            "description": "Angir om minst én melding i dialogen har et transportavvik."
          },
          "harFeilmelding": {
            "type": "boolean",
            "description": "Angir om minst én melding i dialogen er merket som feilmelding."
          },
          "meldingTyper": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startMeldingType": {
            "type": "string"
          },
          "startet": {
            "type": "string",
            "format": "date-time",
            "description": "Sendetidspunktet til startmeldingen. Hvis den mangler, brukes det tidligste registrerte tidspunktet i dialogen."
          },
          "sisteMeldingType": {
            "type": "string"
          },
          "sisteMeldingSendt": {
            "type": "string",
            "format": "date-time"
          },
          "antallMeldinger": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "DialogMedMeldinger": {
        "type": "object",
        "required": [
          "meldingId",
          "startMeldingMangler",
          "harAvvik",
          "harFeilmelding",
          "meldingTyper",
          "startet",
          "sisteMeldingSendt",
          "antallMeldinger",
          "meldinger"
        ],
        "properties": {
          "meldingId": {
            "type": "string",
            "format": "uuid"
          },
          "startMeldingMangler": {
            "type": "boolean"
          },
          "harAvvik": {
            "type": "boolean"
          },
          "harFeilmelding": {
            "type": "boolean"
          },
          "meldingTyper": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startMeldingType": {
            "type": "string"
          },
          "startet": {
            "type": "string",
            "format": "date-time"
          },
          "sisteMeldingType": {
            "type": "string"
          },
          "sisteMeldingSendt": {
            "type": "string",
            "format": "date-time"
          },
          "antallMeldinger": {

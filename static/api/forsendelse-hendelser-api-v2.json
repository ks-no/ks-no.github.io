{
  "openapi": "3.0.1",
  "info": {
    "title": "KS SvarUt: Hendelser API",
    "description": "API for henting av hendelser for forsendelse",
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ksdigital.no"
    },
    "version": "v2"
  },
  "servers": [
    {
      "url": "https://test.svarut.ks.no/api",
      "description": "SvarUt testmiljø"
    },
    {
      "url": "https://svarut.ks.no/api",
      "description": "SvarUt produksjonsmiljø"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Hendelser",
      "description": "API for henting av hendelser for forsendelse"
    }
  ],
  "paths": {
    "/v2/forsendelser/{forsendelseId}/hendelser": {
      "get": {
        "tags": [
          "Hendelser"
        ],
        "summary": "Hent hendelser for forsendelsen",
        "description": "Hent hendelser for forsendelsen",
        "operationId": "hentHendelser",
        "parameters": [
          {
            "name": "forsendelseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hendelser for forsendelsen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hendelser"
                }
              }
            }
          },
          "default": {
            "description": "Feil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/v2/forsendelser/{forsendelseId}/signeringshendelser": {
      "get": {
        "tags": [
          "Hendelser"
        ],
        "summary": "Hent signeringshendelser for forsendelsen",
        "description": "Hent signeringshendelser for forsendelsen",
        "operationId": "hentSigneringshendelser",
        "parameters": [
          {
            "name": "forsendelseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signeringshendelser for forsendelsen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Signeringshendelser"
                }
              }
            }
          },
          "default": {
            "description": "Feil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Hendelse": {
        "required": [
          "hendelse",
          "tidspunkt"
        ],
        "type": "object",
        "properties": {
          "tidspunkt": {
            "type": "string",
            "description": "Tid og dato for hendelsen",
            "format": "date-time",
            "example": "2023-01-01T08:13:14.547+01:00"
          },
          "hendelse": {
            "type": "string",
            "description": "Beskrivelse av hendelsen",
            "example": "Akseptert for ekspedering"
          }
        },
        "description": "Liste av hendelser"
      },
      "Hendelser": {
        "required": [
          "hendelser"
        ],
        "type": "object",
        "properties": {
          "hendelser": {
            "type": "array",
            "description": "Liste av hendelser",
            "items": {
              "$ref": "#/components/schemas/Hendelse"
            }
          }
        }
      },
      "Signeringshendelse": {
        "required": [
          "hendelse",
          "status",
          "tidspunkt"
        ],
        "type": "object",
        "properties": {
          "tidspunkt": {
            "type": "string",
            "description": "Tid og dato for hendelsen",
            "format": "date-time",
            "example": "2023-01-01T08:13:14.547+01:00"
          },
          "status": {
            "type": "string",
            "description": "Status for signeringen",
            "example": "VENTER_SIGNERING",
            "enum": [
              "AVVIST_AV_SVARUT",
              "VENTER_SIGNERING",
              "SIGNERT_AV_MOTTAKER",
              "AVVIST_AV_MOTTAKER",
              "UTLOPT"
            ]
          },
          "hendelse": {
            "type": "string",
            "description": "Beksrivelse av hendelsen",
            "example": "Signeringsoppdrag av type AUTENTISERT_SIGNATUR registrert og utløper 07.01.2023"
          }
        },
        "description": "Liste av signeringshendelser"
      },
      "Signeringshendelser": {
        "required": [
          "hendelser"
        ],
        "type": "object",
        "properties": {
          "hendelser": {
            "type": "array",
            "description": "Liste av signeringshendelser",
            "items": {
              "$ref": "#/components/schemas/Signeringshendelse"
            }
          }
        }
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
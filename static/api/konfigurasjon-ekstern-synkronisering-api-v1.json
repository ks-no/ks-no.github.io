{
  "openapi": "3.0.1",
  "info": {
    "title": "Konfigurasjon ekstern synkronisering API",
    "description": "API for synkronisering av eksterne brukere og grupper fra sentralisert brukerstyring",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ksdigital.no"
    },
    "version": "v1",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://konfigurasjon-ekstern-synkronisering-service:8443",
      "description": "K8s tjeneste for synkronisering"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "brukere",
      "description": "Synkronisering av eksterne brukere"
    },
    {
      "name": "grupper",
      "description": "Synkronisering av eksterne grupper"
    }
  ],
  "paths": {
    "/konfigurasjon/api/v1/synkronisering/{fiksOrgId}/brukere": {
      "post": {
        "operationId": "opprettEksternBruker",
        "description": "Opprett ny ekstern bruker",
        "summary": "Opprett ekstern bruker",
        "tags": [
          "brukere"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NyEksternBruker"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Opprettet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EksternBruker"
                }
              }
            },
            "links": {
              "self": {
                "operationId": "hentEksternBruker",
                "parameters": {
                  "eksternId": "$response.body#/id"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      }
    },
    "/konfigurasjon/api/v1/synkronisering/{fiksOrgId}/brukere/{id}": {
      "get": {
        "operationId": "hentEksternBruker",
        "description": "Hent ekstern bruker",
        "summary": "Hent ekstern bruker",
        "tags": [
          "brukere"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksOrgId"
          },
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EksternBruker"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      },
      "patch": {
        "operationId": "oppdaterEksternBruker",
        "description": "Oppdater ekstern bruker",
        "summary": "Oppdater ekstern bruker",
        "tags": [
          "brukere"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksOrgId"
          },
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OppdaterEksternBruker"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Oppdatert"
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      },
      "delete": {
        "operationId": "slettEksternBruker",
        "description": "Slett ekstern bruker",
        "summary": "Slett ekstern bruker (hard delete)",
        "tags": [
          "brukere"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "responses": {
          "204": {
            "description": "Slettet"
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      }
    },
    "/konfigurasjon/api/v1/synkronisering/{fiksOrgId}/grupper": {
      "post": {
        "operationId": "opprettGruppe",
        "description": "Opprett ny gruppe",
        "summary": "Opprett gruppe",
        "tags": [
          "grupper"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NyEksternGruppe"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Opprettet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EksternGruppe"
                }
              }
            },
            "links": {
              "self": {
                "operationId": "hentGruppe",
                "parameters": {
                  "eksternId": "$response.body#/id"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      }
    },
    "/konfigurasjon/api/v1/synkronisering/{fiksOrgId}/grupper/{id}": {
      "get": {
        "operationId": "hentGruppe",
        "description": "Hent gruppe",
        "summary": "Hent gruppe",
        "tags": [
          "grupper"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EksternGruppe"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      },
      "patch": {
        "operationId": "oppdaterGruppe",
        "description": "Oppdater gruppe",
        "summary": "Oppdater gruppe",
        "tags": [
          "grupper"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OppdaterEksternGruppe"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Oppdatert"
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      },
      "delete": {
        "operationId": "slettGruppe",
        "description": "Slett gruppe",
        "summary": "Slett gruppe (hard delete)",
        "tags": [
          "grupper"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "responses": {
          "204": {
            "description": "Slettet"
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      }
    },
    "/konfigurasjon/api/v1/synkronisering/{fiksOrgId}/grupper/{id}/medlemmer": {
      "patch": {
        "operationId": "endreGruppeMedlemmer",
        "description": "Endre medlemmer i gruppe",
        "summary": "Endre medlemmer i gruppe",
        "tags": [
          "grupper"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndreEksternGruppeMedlemmer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Lagt til"
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      },
      "get": {
        "operationId": "hentGruppeMedlemmer",
        "description": "Hent medlemmer i gruppe",
        "summary": "Hent medlemmer i gruppe",
        "tags": [
          "grupper"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/fiksOrgId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EksternGruppeMedlemmer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UgyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/ManglerTilgang"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NyEksternBruker": {
        "properties": {
          "eksternId": {
            "$ref": "#/components/schemas/EksternId"
          },
          "fnr": {
            "$ref": "#/components/schemas/Fodselsnummer"
          },
          "navn": {
            "$ref": "#/components/schemas/PersonNavn"
          },
          "aktiv": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "eksternId",
          "fnr",
          "navn"
        ]
      },
      "OppdaterEksternBruker": {
        "properties": {
          "fnr": {
            "$ref": "#/components/schemas/Fodselsnummer"
          },
          "navn": {
            "$ref": "#/components/schemas/PersonNavn"
          },
          "aktiv": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "EksternBruker": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UnikId"
          },
          "eksternId": {
            "$ref": "#/components/schemas/EksternId"
          },
          "fnr": {
            "$ref": "#/components/schemas/Fodselsnummer"
          },
          "navn": {
            "$ref": "#/components/schemas/PersonNavn"
          },
          "aktiv": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "eksternId",
          "fnr",
          "navn",
          "aktiv"
        ]
      },
      "NyEksternGruppe": {
        "properties": {
          "eksternId": {
            "$ref": "#/components/schemas/EksternId"
          },
          "navn": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "eksternId",
          "navn"
        ]
      },
      "OppdaterEksternGruppe": {
        "properties": {
          "navn": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "EksternGruppe": {
        "readOnly": true,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UnikId"
          },
          "eksternId": {
            "$ref": "#/components/schemas/EksternId"
          },
          "navn": {
            "type": "string",
            "maxLength": 512
          },
          "medlemmer": {
            "$ref": "#/components/schemas/EksternGruppeMedlemmer"
          }
        },
        "required": [
          "eksternId",
          "navn"
        ]
      },
      "EndreEksternGruppeMedlemmer": {
        "type": "object",
        "properties": {
          "nyeMedlemmer": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EksternId"
            }
          },
          "fjernMedlemmer": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EksternId"
            }
          }
        }
      },
      "EksternGruppeMedlemmer": {
        "type": "object",
        "properties": {
          "medlemmer": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EksternId"
            }
          }
        },
        "required": [
          "medlemmer"
        ]
      },
      "UnikId": {
        "type": "string",
        "description": "Unik identifikator",
        "format": "uuid",
        "example": "123e4567-e89b-12d3-a456-426614174000"
      },
      "EksternId": {
        "$ref": "#/components/schemas/UnikId"
      },
      "OrganisasjonId": {
        "$ref": "#/components/schemas/UnikId"
      },
      "PersonNavn": {
        "description": "Navn på person",
        "type": "string",
        "maxLength": 512
      },
      "Fodselsnummer": {
        "description": "Fødselsnummer",
        "type": "string",
        "pattern": "^[0-9]{11}$"
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "description": "Id tilordnet bruker eller gruppe",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/UnikId"
        }
      },
      "fiksOrgId": {
        "name": "fiksOrgId",
        "in": "path",
        "description": "Fiks organisasjonsid",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OrganisasjonId"
        }
      }
    },
    "responses": {
      "UgyldigParameterverdi": {
        "description": "Ugyldig input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "ManglerTilgang": {
        "description": "Ikke autorisert",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ikke autorisert",
              "status": 403
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
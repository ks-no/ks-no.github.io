{
  "openapi": "3.0.3",
  "info": {
    "title": "KS FIKS: Konsesjon megler-API",
    "description": "API for eiendomsmeglere som skal avklare konsesjonsforhold ved salg av eiendom. Avklaringen gjøres mot Landbruksdirektoratet (LDIR).\n\n**Autentisering:** API-et kan bare brukes av Fiks-integrasjoner. Alle kall må ha et Maskinporten-token med scope `ks:fiks` i `Authorization`-headeren, samt headerne `IntegrasjonId` og `IntegrasjonPassord`. Se https://developers.fiks.ks.no/felles/integrasjoner/.\n\n**Tilgang:** Integrasjonen må ha privilegiet `KONSESJON.QUERY` (lesing) eller `KONSESJON.UPDATE` (lesing og skriving). En konsesjonsavklaring kan bare brukes av organisasjonen som opprettet den.",
    "contact": {
      "name": "Fiks konsesjon",
      "url": "https://www.ks.no/fagomrader/digitalisering/utviklingsprosjekter",
      "email": "fiks-utvikling@ksdigital.no"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.fiks.ks.no",
      "description": "KS Fiks API host"
    },
    {
      "url": "https://api.test.fiks.ks.no",
      "description": "KS Fiks TEST API host"
    }
  ],
  "tags": [
    {
      "name": "Megler - Eiendom",
      "description": "Oppslag om eiendommen som kan gjøres før en konsesjonsavklaring startes"
    },
    {
      "name": "Megler - Konsesjonsavklaring",
      "description": "API for konsesjonsavklaring ved eiendomssalg"
    }
  ],
  "paths": {
    "/konsesjon/api/v1/eiendomssalg/egenerklaering/paakrevd": {
      "get": {
        "tags": [
          "Megler - Eiendom"
        ],
        "summary": "Sjekk om egenerklæring kreves",
        "description": "Slår opp om en egenerklæring er påkrevd for eiendommen, og om eiendommen har boplikt. Kallet oppretter ingen konsesjonsavklaring og kan brukes før en avklaring startes.",
        "operationId": "hentEgenerklaeringPaakrevdOgBoplikt",
        "parameters": [
          {
            "name": "kommunenummer",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Kommunenummer"
            }
          },
          {
            "name": "gaardsnummer",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Gaardsnummer"
            }
          },
          {
            "name": "bruksnummer",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Bruksnummer"
            }
          },
          {
            "name": "festenummer",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Festenummer"
            }
          },
          {
            "name": "seksjonsnummer",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Seksjonsnummer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Krav om egenerklæring og boplikt hentet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EgenerklaeringPaakrevdOgBopliktResponse"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.QUERY eller KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen treff - Fant ingen eiendommer som matchet søkekriteriene",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "502": {
            "description": "Feil mot ekstern tjeneste - Landbruksdirektoratet (LDIR) er midlertidig utilgjengelig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon/api/v1/eiendomssalg/avklaring/start": {
      "post": {
        "tags": [
          "Megler - Konsesjonsavklaring"
        ],
        "summary": "Opprett konsesjonsavklaring",
        "description": "Oppretter en konsesjonsavklaring for én eiendom og returnerer avklaringsId-en som brukes i de videre kallene. Datainnhenting om eiendommen starter i bakgrunnen. Følg med på status til den ikke lenger er INNHENTER_DATA før presjekk kjøres. Erververe oppgis først ved hovedsjekk.",
        "operationId": "opprettKonsesjonsavklaring",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KonsesjonsavklaringOpprettelse"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Konsesjonsavklaring har blitt opprettet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KonsesjonsavklaringReferanse"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen treff - Fant ingen kommune i Fiks-konfigurasjon for kommunenummeret i matrikkelnummeret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "502": {
            "description": "Feil mot ekstern tjeneste - Landbruksdirektoratet (LDIR) eller Fiks-konfigurasjon er midlertidig utilgjengelig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon/api/v1/eiendomssalg/avklaring/{avklaringsId}/presjekk": {
      "post": {
        "tags": [
          "Megler - Konsesjonsavklaring"
        ],
        "summary": "Kjør presjekk",
        "description": "Vurderer ut fra eiendomsdataene om ervervet krever egenerklæring. Krever at datainnhentingen er ferdig. Ved KREVER_IKKE_EGENERKLAERING er ervervet konsesjonsfritt og avklaringen avsluttet. Ved KREVER_EGENERKLAERING fortsetter avklaringen med hovedsjekk.",
        "operationId": "presjekkEgenerklaering",
        "parameters": [
          {
            "in": "path",
            "name": "avklaringsId",
            "description": "ID-en til konsesjonsavklaringen",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Valgfri. Utelat body, eller send et tomt objekt, når det ikke er manuelt innsendte eiendommer.",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresjekkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presjekk fullført",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresjekkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen treff - Fant ikke konsesjonsavklaring som matchet den gitte id-en, eller konsesjonsavklaringen er opprettet av en annen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt - Datainnhenting pågår fremdeles (status INNHENTER_DATA)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "502": {
            "description": "Feil mot ekstern tjeneste - Landbruksdirektoratet (LDIR) er midlertidig utilgjengelig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon/api/v1/eiendomssalg/avklaring/{avklaringsId}/hovedsjekk": {
      "post": {
        "tags": [
          "Megler - Konsesjonsavklaring"
        ],
        "summary": "Kjør hovedsjekk",
        "description": "Sender inn erververne med eierandeler og kjører hovedsjekk av egenerklæringen. Krever at presjekken ga KREVER_EGENERKLAERING. Svaret inneholder ett resultat per erverver. Ved flere erververe kan hver erverver få sin egen avklaringsId, som brukes i de videre kallene for den erververen. Status FERDIGSTILT_AUTOMATISK_GODKJENT eller FERDIGSTILT_TRENGER_MANUELL_OPPFOELGING betyr at egenerklæringen er klar for bekreftelse.",
        "operationId": "hovedsjekkEgenerklaering",
        "parameters": [
          {
            "in": "path",
            "name": "avklaringsId",
            "description": "ID-en til konsesjonsavklaringen",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/ErververMedEierandel"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Hovedsjekk fullført",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HovedsjekkResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen treff - Fant ikke konsesjonsavklaring som matchet den gitte id-en, eller konsesjonsavklaringen er opprettet av en annen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt - Presjekken er ikke bestått for konsesjonsavklaringen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "502": {
            "description": "Feil mot ekstern tjeneste - Landbruksdirektoratet (LDIR), Folkeregisteret eller Enhetsregisteret er midlertidig utilgjengelig, eller ga et ufullstendig svar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon/api/v1/eiendomssalg/avklaring/{avklaringsId}/pdf": {
      "get": {
        "tags": [
          "Megler - Konsesjonsavklaring"
        ],
        "summary": "Hent PDF av egenerklæringen",
        "description": "Returnerer egenerklæringen som PDF. PDF-en er tilgjengelig når hovedsjekken er fullført og avklaringen har status KLAR_FOR_BEKREFTELSE.",
        "operationId": "hentPdf",

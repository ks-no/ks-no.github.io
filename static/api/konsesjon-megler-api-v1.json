            "description": "ID-en til konsesjonsavklaringen",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF generert",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.QUERY eller KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen treff - Fant ikke konsesjonsavklaring som matchet den gitte id-en, eller konsesjonsavklaringen er opprettet av en annen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt - PDF er ikke klar, avklaringen har ikke status KLAR_FOR_BEKREFTELSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "502": {
            "description": "Feil mot ekstern tjeneste - Landbruksdirektoratet (LDIR) er midlertidig utilgjengelig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon/api/v1/eiendomssalg/avklaring/send": {
      "post": {
        "tags": [
          "Megler - Konsesjonsavklaring"
        ],
        "summary": "Send konsesjonsavklaringer til erververne for signering",
        "description": "Sender én eller flere konsesjonsavklaringer til signering. Det opprettes én oppgave i Min Kommune per konsesjonsavklaring, der erververen og eventuelle signaturberettigede personer må signere selv. Megleren signerer ikke. Ved flere erververe sendes avklaringsId-ene fra hovedsjekken samlet. Hver konsesjonsavklaring må ha status KLAR_FOR_BEKREFTELSE.",
        "operationId": "sendEgenerklaering",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GodkjenningsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Konsesjonsavklaringene er sendt til signering"
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen treff - Fant ikke en eller flere av konsesjonsavklaringene som matchet de gitte id-ene, eller konsesjonsavklaringen er opprettet av en annen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt - En eller flere av konsesjonsavklaringene er ikke klare for signering",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon/api/v1/eiendomssalg/avklaring/{avklaringsId}/oppgavestatus": {
      "get": {
        "tags": [
          "Megler - Konsesjonsavklaring"
        ],
        "summary": "Hent status på signering",
        "description": "Returnerer mottakerne av oppgaven i Min Kommune for konsesjonsavklaringen, med status på hver mottakers godkjenning. Mottakerne er erververen når erververen er en person, og de signaturberettigede personene når erververen er en organisasjon. Ved flere erververe har hver erverver sin egen avklaringsId fra hovedsjekken, og status hentes for hver av dem. Kan bare brukes etter at konsesjonsavklaringen er sendt til signering. Er oppgaven i Min Kommune ikke opprettet ennå, returneres de forventede mottakerne med status UNDER_OPPRETTELSE.",
        "operationId": "hentOppgavestatus",
        "parameters": [
          {
            "in": "path",
            "name": "avklaringsId",
            "description": "ID-en til konsesjonsavklaringen",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status på signering hentet",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OppgaveMottakerStatus"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.QUERY eller KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Ingen treff - Fant ikke konsesjonsavklaring som matchet den gitte id-en, eller konsesjonsavklaringen er opprettet av en annen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt - Konsesjonsavklaringen er ikke sendt til signering",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    },
    "/konsesjon/api/v1/eiendomssalg/avklaring/{avklaringsId}/status": {
      "get": {
        "tags": [
          "Megler - Konsesjonsavklaring"
        ],
        "summary": "Hent status for konsesjonsavklaring",
        "description": "Returnerer hvor langt konsesjonsavklaringen har kommet. Brukes blant annet til å vente på at datainnhentingen etter opprettelse er ferdig (status er ikke lenger INNHENTER_DATA).",
        "operationId": "hentKonsesjonsavklaringStatus",
        "parameters": [
          {
            "in": "path",
            "name": "avklaringsId",
            "description": "ID-en til konsesjonsavklaringen",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status for konsesjonsavklaring hentet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KonsesjonsavklaringStatus"
                }
              }
            }
          },
          "400": {
            "description": "Feil input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ikke autentisert – bearer token mangler eller er ugyldig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke tilgang – kalleren er ikke en integrasjon med privilegiet KONSESJON.QUERY eller KONSESJON.UPDATE",
            "content": {
              "application/json": {
                "schema": {

            "nullable": true
          },
          "kortBeskrivelse": {
            "type": "string",
            "maxLength": 200,
            "nullable": true,
            "description": "Utledes fra beskrivelse eller navn når den ikke oppgis. Systemkatalog lagrer feltet som VARCHAR(200)."
          },
          "lagtTilAv": {
            "type": "string",
            "maxLength": 100,
            "nullable": true,
            "description": "Navnet på personen som registrerer produktet. Ansattporten-tokenet gir bare pid og virksomhetsnavn, så navnet må oppgis av klienten. Et fødselsnummer avvises. Settes til «Leverandørportalen» når det ikke oppgis."
          },
          "produktKategoriId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "klassifisering": {
            "$ref": "#/components/schemas/Klassifisering",
            "nullable": true
          },
          "webadresse": {
            "type": "string",
            "format": "uri",
            "maxLength": 255,
            "nullable": true,
            "description": "Kun http eller https. Systemkatalog lagrer feltet som VARCHAR(255)."
          },
          "kildeKode": {
            "type": "string",
            "format": "uri",
            "maxLength": 255,
            "nullable": true,
            "description": "Kun http eller https. Systemkatalog lagrer feltet som VARCHAR(255)."
          }
        }

{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Min Kommune: Faktura Innbygger API",
    "description": "API for søk etter fakturaer for innbyggere.",
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ksdigital.no"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://min.kommune.no",
      "description": "KS Fiks Min Kommune intern api"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "FakturaSok",
      "description": "API for søk etter fakturaer for innbyggere"
    }
  ],
  "paths": {
    "/min-kommune/api/v1/innbygger/faktura/sok": {
      "post": {
        "tags": [
          "FakturaSok"
        ],
        "summary": "Søk etter fakturaer",
        "operationId": "sokFaktura",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "description": "Søkeord",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "side",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sideStorrelse",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sortering",
            "in": "query",
            "description": "Sortering av søkeresultatet. Relevans-basert sortering er standard.",
            "schema": {
              "$ref": "#/components/schemas/Sortering"
            }
          },
          {
            "name": "onBehalfOf",
            "in": "query",
            "description": "Organisasjonsnummer for organisasjonen forespørselen utføres på vegne av. Krever at autentisert bruker har rettigheter til å agere på vegne av organisasjonen.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Filtre som begrenser resultatsettet",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FakturaFilter"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Søkeresultat for faktura",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FakturaSokeresultat"
                }
              }
            }
          },
          "400": {
            "description": "Ugyldig forespørsel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Ingen tilgang",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Ikke autorisert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "500": {
            "description": "Systemfeil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "errorId": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string"
          },
          "originalPath": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "errorJson": {
            "type": "string"
          }
        }
      },
      "AdresseV1": {
        "type": "object",
        "properties": {
          "navn": {
            "type": "string"
          },
          "adresselinje1": {
            "type": "string"
          },
          "adresselinje2": {
            "type": "string"
          },
          "adresselinje3": {
            "type": "string"
          },
          "poststed": {
            "type": "string"
          },
          "postnummer": {
            "type": "string"
          },
          "land": {
            "type": "string"
          }
        }
      },
      "ArstallAggregering": {
        "required": [
          "antallTreff",
          "arstall"
        ],
        "type": "object",
        "properties": {
          "arstall": {
            "type": "string"
          },
          "antallTreff": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Driftsmelding": {
        "required": [
          "fiksOrgId",
          "id",
          "innhold",
          "meldingType"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fiksOrgId": {
            "type": "string",
            "format": "uuid"
          },
          "innhold": {
            "type": "string"
          },
          "meldingType": {
            "$ref": "#/components/schemas/MeldingType"
          },
          "startDato": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "sluttDato": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "urlTekst": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EksternLenke": {
        "required": [
          "tittel",
          "url"
        ],
        "type": "object",
        "properties": {
          "tittel": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "FakturaAggregeringer": {
        "required": [
          "arstall",
          "fakturastatus",
          "fiksOrganisasjon"
        ],
        "type": "object",
        "properties": {
          "fiksOrganisasjon": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FiksOrganisasjonAggregering"
            }
          },
          "fakturastatus": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FakturastatusAggregering"
            }
          },
          "arstall": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArstallAggregering"
            }
          }
        }
      },
      "FakturaFilter": {
        "type": "object",
        "properties": {
          "fiksOrganisasjon": {
            "uniqueItems": true,
            "type": "array",
            "description": "Begrens søkeresultatet til fakturaer eid av disse Fiks-organisasjonene",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "status": {
            "uniqueItems": true,
            "type": "array",
            "description": "Begrens søkeresultatet til fakturaer med bestemte statuser",
            "items": {
              "$ref": "#/components/schemas/FakturaStatus"
            }
          },
          "arstall": {
            "uniqueItems": true,
            "type": "array",
            "description": "Begrens søkeresultatet til fakturaer fra bestemte årstall",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "FakturaKontaktInformasjonV1": {
        "type": "object",
        "properties": {
          "navn": {
            "type": "string"
          },
          "telefonnummer": {
            "type": "string"
          },
          "epost": {
            "type": "string"
          },
          "fritekst": {
            "type": "string"
          },
          "adresse": {
            "$ref": "#/components/schemas/AdresseV1"
          }
        }
      },
      "FakturaLenkeV1": {
        "required": [
          "tittel",
          "url"
        ],
        "type": "object",
        "properties": {
          "tittel": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "FakturaPdfV1": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "tittel": {
            "type": "string"
          }
        }
      },
      "FakturaSokeresultat": {
        "required": [
          "aggregeringer",
          "antallTreff",
          "driftsmeldinger",
          "eksterneLenker",
          "forespurtAntall",
          "forespurtFra",
          "harMeldingerMedHoyereSikkerhetsniva",
          "totalAntall",
          "totalAntallUtenFilter",
          "treff",
          "treffMedHoyereInnloggingsniva"
        ],
        "type": "object",
        "properties": {
          "antallTreff": {
            "type": "integer",
            "format": "int64"
          },
          "treffMedHoyereInnloggingsniva": {
            "type": "integer",
            "format": "int64"
          },
          "harMeldingerMedHoyereSikkerhetsniva": {
            "type": "boolean"
          },
          "treff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeldingV1FakturaV1"
            }
          },
          "forespurtFra": {
            "type": "integer",
            "format": "int32"
          },
          "forespurtAntall": {
            "type": "integer",
            "format": "int32"
          },
          "aggregeringer": {
            "$ref": "#/components/schemas/FakturaAggregeringer"
          },
          "driftsmeldinger": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Driftsmelding"
            }
          },
          "eksterneLenker": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EksternLenke"
            }
          },
          "totalAntall": {
            "type": "integer",
            "format": "int64",
            "description": "Totalt antall fakturaer i søkeresultatet."
          },
          "totalAntallUtenFilter": {
            "type": "integer",
            "format": "int64",
            "description": "Totalt antall fakturaer i søkeresultatet uten filter."
          }
        }
      },
      "FakturaStatus": {
        "type": "string",
        "enum": [
          "BETALT",
          "IKKE_BETALT",
          "INKASSOVARSEL",
          "SENDT_INKASSO",
          "INKASSO"
        ]
      },
      "FakturaVedleggV1": {
        "required": [
          "tittel",
          "url"
        ],
        "type": "object",
        "properties": {
          "tittel": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "FakturastatusAggregering": {
        "required": [
          "antallTreff",
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "antallTreff": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "FiksOrganisasjon": {
        "required": [
          "id",
          "visningsnavn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "visningsnavn": {
            "type": "string"
          }
        }
      },
      "FiksOrganisasjonAggregering": {
        "required": [
          "antallTreff",
          "fiksOrg"
        ],
        "type": "object",
        "properties": {
          "fiksOrg": {
            "$ref": "#/components/schemas/FiksOrganisasjon"
          },
          "antallTreff": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "HistoriskFakturaV1": {
        "required": [
          "tittel",
          "url"
        ],
        "type": "object",
        "properties": {
          "tittel": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "fakturaDato": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "MeldingFiksOrganisasjon": {
        "required": [
          "id",
          "visningsnavn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "visningsnavn": {
            "type": "string"
          },
          "kommunenummer": {
            "type": "string"
          }
        }
      },
      "MeldingType": {
        "type": "string",
        "enum": [
          "INFORMASJON",
          "ADVARSEL",
          "FEIL"
        ]
      },
      "MeldingV1FakturaV1": {
        "required": [
          "dokumentId",
          "fiksOrganisasjon",
          "meldingId",
          "meldingMetadata",
          "sikkerhetsniva"
        ],
        "type": "object",
        "properties": {
          "meldingId": {
            "type": "string",
            "format": "uuid"
          },
          "dokumentId": {
            "type": "string"
          },
          "sikkerhetsniva": {
            "type": "integer",
            "format": "int32"
          },
          "fiksOrganisasjon": {
            "$ref": "#/components/schemas/MeldingFiksOrganisasjon"
          },
          "sorteringDato": {
            "type": "string",
            "format": "date-time"
          },
          "korrelasjonId": {
            "type": "string"
          },
          "eksternRef": {
            "type": "string"
          },
          "meldingMetadata": {
            "$ref": "#/components/schemas/FakturaV1"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "tilgjengeligTil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FakturaV1": {
        "required": [
          "belop",
          "betalesTil",
          "fakturaDato",
          "fakturaMottaker",
          "forfallDato",
          "tittel"
        ],
        "type": "object",
        "description": "Faktura",
        "properties": {
          "tittel": {
            "type": "string"
          },
          "fakturaDato": {
            "type": "string",
            "format": "date"
          },
          "forfallDato": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "$ref": "#/components/schemas/FakturaStatus"
          },
          "fakturaMottaker": {
            "type": "string"
          },
          "betalesTil": {
            "type": "string"
          },
          "belop": {
            "type": "number",
            "format": "double"
          },
          "gebyr": {
            "type": "number",
            "format": "double"
          },
          "renter": {
            "type": "number",
            "format": "double"
          },
          "andreOmkostninger": {
            "type": "number",
            "format": "double"
          },
          "totalbelop": {
            "type": "number",
            "format": "double"
          },
          "utestaendeBelop": {
            "type": "number",
            "format": "double"
          },
          "kreditertBelop": {
            "type": "number",
            "format": "double"
          },
          "innbetaltBelop": {
            "type": "number",
            "format": "double"
          },
          "kontonummer": {
            "type": "string"
          },
          "kid": {
            "type": "string"
          },
          "fakturanummer": {
            "type": "string"
          },
          "forsendelseskanal": {
            "type": "string",
            "enum": [
              "AVTALEGIRO",
              "EFAKTURA",
              "POST",
              "EPOST",
              "DIGIPOST",
              "EBOKS"
            ]
          },
          "faktura": {
            "$ref": "#/components/schemas/FakturaPdfV1"
          },
          "fakturahistorikk": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoriskFakturaV1"
            }
          },
          "vedlegg": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FakturaVedleggV1"
            }
          },
          "lenker": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FakturaLenkeV1"
            }
          },
          "kontaktinformasjon": {
            "$ref": "#/components/schemas/FakturaKontaktInformasjonV1"
          },
          "kontaktinformasjonInkasso": {
            "$ref": "#/components/schemas/FakturaKontaktInformasjonV1"
          },
          "kanBetales": {
            "type": "boolean"
          },
          "korrigert": {
            "type": "boolean"
          },
          "sendtTilEkstern": {
            "type": "boolean"
          },
          "eksternLenke": {
            "$ref": "#/components/schemas/FakturaLenkeV1"
          },
          "beskrivelse": {
            "type": "string"
          }
        }
      },
      "Sortering": {
        "type": "string",
        "enum": [
          "DATO_ASC",
          "DATO_DESC",
          "RELEVANS"
        ]
      }
    }
  }
}
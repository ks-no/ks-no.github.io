{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Min Kommune: Felles Konfigurasjon API",
    "description": "API for forvaltning av felles konfigurasjon i Min Kommune.",
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://developers.fiks.ks.no/",
      "email": "fiks@ksdigital.no"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://forvaltning.fiks.ks.no",
      "description": "KS Fiks API host"
    },
    {
      "url": "https://forvaltning.fiks.test.ks.no",
      "description": "KS Fiks API test host"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "FellesKonfigurasjon",
      "description": "API for å konfigurere felles innstillinger for Min Kommune"
    }
  ],
  "paths": {
    "/min-kommune/api/v1/konfigurasjon/felles/{fiksOrgId}/kontaktmetode": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FiksOrgId"
        }
      ],
      "put": {
        "tags": [
          "FellesKonfigurasjon"
        ],
        "summary": "Lagre kontaktmetode for en organisasjon",
        "description": "Oppretter kontaktmetoden dersom organisasjonen ikke har en fra før (201), eller erstatter den eksisterende kontaktmetoden (200). Hele den lagrede kontaktmetoden returneres i begge tilfeller. Både type og kontaktadresse må oppgis, og typen kan endres. Operasjonen er idempotent og krever en innlogget person med ADMIN på Innsyn-ressursen (TJENESTE_INNSYN) direkte under den aktuelle Fiks-organisasjonen. Arvede privilegier tas med. Kontaktadressen valideres ut fra valgt type; ugyldig type eller kontaktadresse gir 400 uten å endre lagret konfigurasjon.",
        "operationId": "lagreKontaktmetode",
        "requestBody": {
          "$ref": "#/components/requestBodies/Kontaktmetode"
        },
        "responses": {
          "200": {
            "description": "Kontaktmetode erstattet. Returnerer hele den lagrede kontaktmetoden.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Kontaktmetode"
                }
              }
            }
          },
          "201": {
            "description": "Kontaktmetode opprettet. Returnerer hele den lagrede kontaktmetoden.",
            "headers": {
              "Location": {
                "description": "URL til den opprettede kontaktmetoden.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Kontaktmetode"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UgyldigForesporsel"
          },
          "401": {
            "$ref": "#/components/responses/IkkeAutentisert"
          },
          "403": {
            "$ref": "#/components/responses/IngenTilgang"
          },
          "500": {
            "$ref": "#/components/responses/Systemfeil"
          }
        }
      },
      "get": {
        "tags": [
          "FellesKonfigurasjon"
        ],
        "summary": "Hent kontaktmetode for en organisasjon",
        "description": "Returnerer organisasjonens konfigurerte kontaktmetode. Krever en innlogget person med ADMIN på Innsyn-ressursen (TJENESTE_INNSYN) direkte under den aktuelle Fiks-organisasjonen. Arvede privilegier tas med. Dersom ingen kontaktmetode er opprettet, returneres 404.",
        "operationId": "hentKontaktmetode",
        "responses": {
          "200": {
            "description": "Organisasjonens kontaktmetode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Kontaktmetode"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/UgyldigForesporsel"
          },
          "401": {
            "$ref": "#/components/responses/IkkeAutentisert"
          },
          "403": {
            "$ref": "#/components/responses/IngenTilgang"
          },
          "404": {
            "$ref": "#/components/responses/KontaktmetodeIkkeFunnet"
          },
          "500": {
            "$ref": "#/components/responses/Systemfeil"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "FiksOrgId": {
        "name": "fiksOrgId",
        "in": "path",
        "description": "Fiks-organisasjonen kontaktmetoden gjelder for.",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "requestBodies": {
      "Kontaktmetode": {
        "description": "Kontaktmetodens type og tilhørende kontaktadresse.",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Kontaktmetode"
            },
            "examples": {
              "epost": {
                "summary": "Kontakt via e-post",
                "value": {
                  "type": "EPOST",
                  "kontaktadresse": "post@eksempel.kommune.no"
                }
              },
              "kontaktskjema": {
                "summary": "Kontakt via kontaktskjema",
                "value": {
                  "type": "KONTAKTSKJEMA",
                  "kontaktadresse": "https://eksempel.kommune.no/kontakt"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "UgyldigForesporsel": {
        "description": "Ugyldig forespørsel, for eksempel ugyldig fiksOrgId, ukjent kontaktmetodetype eller ugyldig kontaktadresse for valgt type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "IkkeAutentisert": {
        "description": "Manglende eller ugyldig autentisering.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "IngenTilgang": {
        "description": "Den autentiserte brukeren har ikke tilgang til organisasjonens konfigurasjon.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "KontaktmetodeIkkeFunnet": {
        "description": "Ingen kontaktmetode er opprettet for organisasjonen.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "Systemfeil": {
        "description": "Systemfeil",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      }
    },
    "schemas": {
      "Kontaktmetode": {
        "type": "object",
        "description": "Organisasjonens kontaktmetode. Kontaktadressen valideres av tjenesten ut fra valgt type.",
        "required": [
          "type",
          "kontaktadresse"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/KontaktmetodeType"
          },
          "kontaktadresse": {
            "type": "string",
            "minLength": 1,
            "description": "Adressen som benyttes for kontakt. For EPOST må verdien være en gyldig e-postadresse uten mailto:-prefiks. For KONTAKTSKJEMA må verdien være en absolutt HTTP- eller HTTPS-URL til kontaktskjemaet. Valideringen avhenger av type; feltet har derfor ikke ett felles format.",
            "example": "post@eksempel.kommune.no"
          }
        }
      },
      "KontaktmetodeType": {
        "type": "string",
        "description": "Type kontaktmetode: EPOST for e-postadresse og KONTAKTSKJEMA for URL til et kontaktskjema. Flere typer kan legges til senere.",
        "enum": [
          "EPOST",
          "KONTAKTSKJEMA"
        ]
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "errorId": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string"
          },
          "originalPath": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "errorJson": {
            "type": "string"
          }
        }
      }
    }
  }
}
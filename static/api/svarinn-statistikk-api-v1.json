{
  "openapi": "3.0.1",
  "info": {
    "title": "Fiks SvarUt: SvarInn Statistikk",
    "description": "SvarInn Statistikk API som gir oversikt over forsendelser knyttet mot et mottakersystem.",
    "contact": {
      "name": "Fiks brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks@ksdigital.no"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v3"
  },
  "servers": [
    {
      "url": "https://test.svarut.ks.no/api",
      "description": "SvarUt testmiljø"
    },
    {
      "url": "https://svarut.ks.no/api",
      "description": "SvarUt produksjonsmiljø"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "StatistikkSvarInn",
      "description": "Operasjoner for statistikk over SvarInn-forsendelser"
    }
  ],
  "paths": {
    "/svarinn-statistikk/api/v1/mottakersystemer/{mottakersystemId}": {
      "get": {
        "tags": [
          "StatistikkSvarInn"
        ],
        "description": "Henter statistikk om et mottakersystem",
        "summary": "Henter statistikk om et mottakersystem",
        "operationId": "hentMottakersystemStatistikk",
        "parameters": [
          {
            "$ref": "#/components/parameters/MottakersystemId"
          },
          {
            "$ref": "#/components/parameters/OverGrenseverdi"
          }
        ],
        "responses": {
          "200": {
            "description": "Statistikk for et mottakersystem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MottakersystemStatistikk"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/svarinn-statistikk/api/v1/mottakersystemer/bulk": {
      "post": {
        "tags": [
          "StatistikkSvarInn"
        ],
        "summary": "Henter statistikk om flere mottakersystemer",
        "operationId": "hentMottakersystemerStatistikk",
        "parameters": [
          {
            "$ref": "#/components/parameters/OverGrenseverdi"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MottakersystemerStatistikkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Statistikk for flere mottakersystem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MottakersystemerStatistikk"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/svarinn-statistikk/api/v1/mottakersystemer/{mottakersystemId}/organisasjoner/{organisasjonsnummer}": {
      "get": {
        "tags": [
          "StatistikkSvarInn"
        ],
        "description": "Henter statistikk om antall forsendelser som er klart for mottak for en organisasjon knyttet til et mottakersystem.",
        "summary": "Henter statistikk om en organisasjon",
        "operationId": "hentOrganisasjonStatistikk",
        "parameters": [
          {
            "$ref": "#/components/parameters/MottakersystemId"
          },
          {
            "$ref": "#/components/parameters/Organisasjonsnummer"
          },
          {
            "$ref": "#/components/parameters/OverGrenseverdi"
          }
        ],
        "responses": {
          "200": {
            "description": "Statistikk for post som ligger i Klart for mottak for et gitt organisasjonsnummer knyttet til et mottakersystem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisasjonStatistikk"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MottakersystemId": {
        "name": "mottakersystemId",
        "description": "Mottakersystemets id",
        "required": true,
        "in": "path",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Organisasjonsnummer": {
        "name": "organisasjonsnummer",
        "description": "Organisasjonsnummeret til organisasjonen som skal hentes statistikk for",
        "required": true,
        "in": "path",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{9}$"
        }
      },
      "OverGrenseverdi": {
        "name": "overGrenseverdi",
        "description": "Grenseverdi som brukes for å gruppere forsendelser etter hvor lenge de har ligget klare til uthenting i mottakersystemet",
        "in": "query",
        "required": false,
        "schema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/components/schemas/Tidsgrenseverdi"
          }
        },
        "style": "form",
        "explode": true
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Error400": {
        "description": "Ugyldig forespørsel",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage-2"
            }
          }
        }
      },
      "Error401": {
        "description": "Autentisering feilt",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage-2"
            }
          }
        }
      },
      "Error403": {
        "description": "Ingen tilgang",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage-2"
            }
          }
        }
      },
      "Error500": {
        "description": "Systemfeil",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage-2"
            }
          }
        }
      }
    },
    "schemas": {
      "MottakersystemStatistikk": {
        "type": "object",
        "required": [
          "organisasjoner"
        ],
        "description": "Statistikk for forsendelser som er klare for å hentes ut av fagsystem",
        "properties": {
          "mottakersystemId": {
            "type": "string",
            "format": "uuid",
            "description": "Mottakersystemets id"
          },
          "organisasjoner": {
            "type": "array",
            "description": "Liste med en eller flere organisasjoner som har forsendelser klare for uthenting",
            "items": {
              "$ref": "#/components/schemas/OrganisasjonStatistikk"
            }
          }
        }
      },
      "MottakersystemerStatistikkRequest": {
        "type": "object",
        "required": [
          "mottakersystemIder"
        ],
        "description": "Liste av mottakersystem-id'er",
        "properties": {
          "mottakersystemIder": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "MottakersystemerStatistikk": {
        "type": "object",
        "required": [
          "mottakersystemer"
        ],
        "description": "Statistikk for forsendelser som er klare for å hentes ut, gruppert per mottakersystem",
        "properties": {
          "mottakersystemer": {
            "type": "array",
            "description": "Statistikk for hvert av mottakersystemene det er forespurt statistikk for",
            "items": {
              "$ref": "#/components/schemas/MottakersystemStatistikk"
            }
          }
        }
      },
      "OrganisasjonStatistikk": {
        "type": "object",
        "properties": {
          "organisasjonsnummer": {
            "type": "string",
            "description": "Organisasjonsnummeret det er hentet statistikk for"
          },
          "forsendelserKlareForUthenting": {
            "required": [
              "totalt",
              "overGrenseverdi"
            ],
            "type": "object",
            "description": "Statistikk for forsendelser som er klare for å hentes ut av fagsystem",
            "properties": {
              "totalt": {
                "type": "integer",
                "format": "int32",
                "minimum": 0,
                "description": "Totalt antall forsendelser som er klare for å hentes ut fra mottakersystemet"
              },
              "overGrenseverdi": {
                "type": "array",
                "description": "Liste med en eller flere grupperinger med forsendelser som har ligget klare til mottak over en gitt grenseverdi",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "properties": {
                    "antall": {
                      "type": "integer",
                      "format": "int32",
                      "minimum": 0,
                      "description": "Antall forsendelser over grenseverdi"
                    },
                    "grenseverdi": {
                      "$ref": "#/components/schemas/Tidsgrenseverdi"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Organisasjonsnummer": {
        "type": "string",
        "pattern": "^[0-9]{9}$",
        "description": "Organisasjonsnummeret til organisasjonen som skal hentes statistikk for"
      },
      "Tidsgrenseverdi": {
        "type": "string",
        "format": "duration",
        "example": "P3Y6M4DT12H30M5S",
        "description": "Grenseverdi for tid",
        "maxLength": 100
      },
      "ErrorMessage": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "errorId": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string"
          },
          "originalPath": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "errorJson": {
            "type": "string"
          }
        }
      },
      "ErrorMessage-2": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}
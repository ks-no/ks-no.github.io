{
  "openapi": "3.0.1",
  "info": {
    "title": "KS Fiks: Aktiverte tjenester",
    "description": "Fiks konfigurasjon: Aktiverte tjenester",
    "contact": {
      "name": "Fiks-brukerstøtte",
      "url": "https://ks-no.github.io/",
      "email": "fiks-utvikling@ksdigital.no"
    },
    "version": "v1",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.fiks.test.ks.no",
      "description": "KS Fiks API host"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "AktiverteTjenester",
      "description": "API for oppslag på aktiverte tjenester"
    }
  ],
  "paths": {
    "/konfigurasjon/api/v1/aktiverte-tjenester/{tjenestekode}/organisasjoner": {
      "get": {
        "description": "Henter informasjon om hvilke organisasjoner som har aktivert en gitt tjeneste",
        "tags": [
          "AktiverteTjenester"
        ],
        "summary": "Henter informasjon om hvilke organisasjoner som har aktivert en gitt tjeneste. Kun tilgang for integrasjon med KONFIGURASJON_QUERY på ROOT",
        "operationId": "hentOrganisasjonerMedAktivertTjeneste",
        "parameters": [
          {
            "$ref": "#/components/parameters/tjenestekode"
          },
          {
            "$ref": "#/components/parameters/organisasjonstype"
          }
        ],
        "responses": {
          "200": {
            "description": "Aktivert tjeneste",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AktivertTjenesterOversikt"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ugyldigParameterverdi"
          },
          "403": {
            "$ref": "#/components/responses/manglerTilgang"
          },
          "404": {
            "$ref": "#/components/responses/ukjentRessurs"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "tjenestekode": {
        "name": "tjenestekode",
        "in": "path",
        "description": "Kode for tjenesten",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/Tjenestekode"
        }
      },
      "organisasjonstype": {
        "name": "organisasjonstype",
        "in": "query",
        "description": "Filtrer på organisasjonstype",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/Organisasjonstype"
        }
      }
    },
    "responses": {
      "ugyldigParameterverdi": {
        "description": "Ugyldig input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            }
          }
        }
      },
      "manglerTilgang": {
        "description": "Ikke autorisert",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Ikke autorisert",
              "status": 403
            }
          }
        }
      },
      "ukjentRessurs": {
        "description": "Finner ingen ressurs for oppgitte parametre",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorMessage"
            },
            "example": {
              "message": "Finner ingen ressurs for oppgitte parametre",
              "status": 404
            }
          }
        }
      }
    },
    "schemas": {
      "Tjenestekode": {
        "type": "string",
        "description": "Kode for tjenesten",
        "pattern": "^[A-Z0-9_.]+$",
        "example": "TJENESTEN"
      },
      "AktivertTjenesterOversikt": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "tjenestekode": {
            "$ref": "#/components/schemas/Tjenestekode"
          },
          "organisasjoner": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organisasjon"
            }
          }
        },
        "required": [
          "tjenestekode",
          "organisasjoner"
        ]
      },
      "fiksOrganisasjonId": {
        "type": "string",
        "format": "uuid",
        "description": "Fiks Organisasjon Id",
        "example": "123e4567-e89b-12d3-a456-426614174000"
      },
      "Organisasjon": {
        "type": "object",
        "properties": {
          "organisasjonsnummer": {
            "type": "string",
            "description": "Organisasjonsnummer",
            "pattern": "^[0-9]{9}$",
            "example": "123456789"
          },
          "fiksOrganisasjonId": {
            "$ref": "#/components/schemas/fiksOrganisasjonId"
          },
          "navn": {
            "type": "string",
            "description": "Navn på organisasjonen",
            "example": "Organisasjon AS"
          },
          "type": {
            "$ref": "#/components/schemas/Organisasjonstype"
          }
        },
        "required": [
          "organisasjonsnummer",
          "fiksOrganisasjonId",
          "navn",
          "type"
        ]
      },
      "Organisasjonstype": {
        "type": "string",
        "description": "Organisasjonens type",
        "enum": [
          "UKJENT",
          "KOMMUNE",
          "FYLKESKOMMUNE",
          "KOMMUNAL_VIRKSOMHET",
          "KOMMUNAL_VIRKSOMHET_IKS",
          "STATLIG_VIRKSOMHET",
          "PRIVAT_VIRKSOMHET"
        ],
        "example": "KOMMUNE"
      },
      "ErrorMessage": {
        "type": "object",
        "description": "Feilmelding fra Fiks-plattformen",
        "externalDocs": {
          "description": "Beskrivelse av feilmeldinger",
          "url": "https://ks-no.github.io/fiks-plattform/integrasjoner/#feilmeldinger"
        },
        "properties": {
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Tidspunktet da feilen oppstod, angitt som antall millisekunder siden Unix-epoch.",
            "example": 1767222000000
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP-statuskode for feilen.",
            "example": 400
          },
          "error": {
            "type": "string",
            "description": "Standardtekst for HTTP-statuskoden.",
            "example": "Bad Request"
          },
          "errorId": {
            "type": "string",
            "format": "uuid",
            "description": "Unik identifikator for feilen. Kan oppgis ved henvendelser for å spore feilen.",
            "example": "15a92338-8d98-4b05-a8a6-a879913259fd"
          },
          "path": {
            "type": "string",
            "description": "Stien i forespørselen som førte til feilen.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "originalPath": {
            "type": "string",
            "nullable": true,
            "description": "Opprinnelig forespurt sti før eventuell intern feilhåndtering. Feltet er vanligvis utelatt eller satt til null.",
            "example": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112"
          },
          "message": {
            "type": "string",
            "description": "Menneskeliglesbar melding som beskriver feilen.",
            "example": "Noe gikk galt"
          },
          "errorCode": {
            "type": "string",
            "pattern": "^[A-Z]{1,10}-[0-9]{4}$",
            "description": "Maskinlesbar kode som identifiserer feiltypen. Koden følger formatet <applikasjonsprefiks>-<feilkode>.",
            "example": "FIKS-0001"
          },
          "errorJson": {
            "type": "string",
            "deprecated": true,
            "description": "Felt med ekstra feilinformasjon som en JSON-kodet streng. Strukturen avhenger av errorCode. Nye tjenester skal bruke errorDetails i stedet.",
            "example": "{\"fiksOrgId\": \"1a5038d7-c1fe-4110-9310-fe3b096a0564\", \"externalReference\": \"a8793ee2-b7b2-40a5-9731-51e018244cf4\"}"
          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": true,
            "description": "Maskinlesbar tilleggsinformasjon om feilen. Strukturen avhenger av errorCode.",
            "example": {
              "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
              "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
            }
          }
        },
        "example": {
          "timestamp": 1767222000000,
          "status": 400,
          "error": "Bad Request",
          "errorId": "15a92338-8d98-4b05-a8a6-a879913259fd",
          "path": "/tjeneste/api/v1/meldinger/40441e83-5120-445d-8c31-63ed2f4e8112",
          "message": "Ugyldig forespørsel",
          "errorCode": "FIKS-0001",
          "errorDetails": {
            "fiksOrgId": "1a5038d7-c1fe-4110-9310-fe3b096a0564",
            "externalReference": "a8793ee2-b7b2-40a5-9731-51e018244cf4"
          }
        }
      }
    }
  }
}